rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true
        || (
          request.auth.token.firebase.sign_in_provider == 'phone'
          && request.auth.token.phone_number is string
          && request.auth.token.phone_number.size() >= 5
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCode(code) {
      return code is string && code.size() >= 3 && code.size() <= 32 && code.matches('^[A-Z0-9\\-]+$');
    }

    // Zero-lookup admin check (strictly requires verified email, never phone auth)
    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'inscondtco@gmail.com';
    }

    // Full admin check (used on single-document reads and writes)
    function isAdmin() {
      return isAdminEmail()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidClientAccount(data, userId) {
      return data.keys().hasAll([
          'uid', 'fullName', 'email', 'phone', 'organizationName',
          'role', 'approvalStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'email', 'phone', 'organizationName',
          'requestedCompanyCode', 'assignedCompanyId', 'assignedCompanyCode',
          'role', 'approvalStatus', 'sector',
          'authMethod', 'jobTitle', 'nationalId', 'secondaryPhone',
          'personalAddress', 'organizationNameEn', 'commercialRegNo',
          'taxCardNo', 'companyPhone', 'companyEmail', 'website',
          'companyAddress', 'cityGovernorate', 'activeScope',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.phone is string && (data.phone == '' || (data.phone.size() >= 5 && data.phone.size() <= 40))
        && data.organizationName is string && (data.organizationName == '' || (data.organizationName.size() >= 2 && data.organizationName.size() <= 160))
        && (!('requestedCompanyCode' in data) || (data.requestedCompanyCode is string && data.requestedCompanyCode.size() <= 32 && data.requestedCompanyCode.matches('^[A-Z0-9\\-]*$')))
        && (!('assignedCompanyId' in data) || (data.assignedCompanyId is string && data.assignedCompanyId.size() <= 128))
        && (!('assignedCompanyCode' in data) || (data.assignedCompanyCode is string && data.assignedCompanyCode.size() <= 32))
        && (!('sector' in data) || (data.sector is string && data.sector.size() <= 80))
        && (!('authMethod' in data) || data.authMethod in ['google', 'email', 'phone'])
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 120))
        && (!('nationalId' in data) || (data.nationalId is string && data.nationalId.size() <= 40))
        && (!('secondaryPhone' in data) || (data.secondaryPhone is string && data.secondaryPhone.size() <= 40))
        && (!('personalAddress' in data) || (data.personalAddress is string && data.personalAddress.size() <= 240))
        && (!('organizationNameEn' in data) || (data.organizationNameEn is string && data.organizationNameEn.size() <= 180))
        && (!('commercialRegNo' in data) || (data.commercialRegNo is string && data.commercialRegNo.size() <= 64))
        && (!('taxCardNo' in data) || (data.taxCardNo is string && data.taxCardNo.size() <= 64))
        && (!('companyPhone' in data) || (data.companyPhone is string && data.companyPhone.size() <= 40))
        && (!('companyEmail' in data) || (data.companyEmail is string && data.companyEmail.size() <= 160))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && (!('companyAddress' in data) || (data.companyAddress is string && data.companyAddress.size() <= 240))
        && (!('cityGovernorate' in data) || (data.cityGovernorate is string && data.cityGovernorate.size() <= 100))
        && (!('activeScope' in data) || (data.activeScope is string && data.activeScope.size() <= 1000))
        && data.role in ['client', 'engineer', 'admin']
        && data.approvalStatus in ['pending', 'approved', 'suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClientRequest(data) {
      return data.keys().hasAll([
          'requestCode', 'submittedByUid', 'submittedByEmail', 'companyName',
          'contactName', 'phone', 'serviceMethods', 'projectLocation',
          'urgency', 'scopeSummary', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestCode', 'submittedByUid', 'submittedByEmail', 'companyName',
          'companyCode', 'contactName', 'phone', 'serviceMethods',
          'projectLocation', 'urgency', 'scopeSummary', 'status',
          'adminNotes', 'createdAt', 'updatedAt'
        ])
        && isValidCode(data.requestCode)
        && isValidId(data.submittedByUid)
        && data.submittedByEmail is string && data.submittedByEmail.size() >= 3 && data.submittedByEmail.size() <= 160
        && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 160
        && (!('companyCode' in data) || (data.companyCode is string && data.companyCode.size() <= 32 && data.companyCode.matches('^[A-Z0-9\\-]*$')))
        && data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 120
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && data.serviceMethods is list && data.serviceMethods.size() >= 1 && data.serviceMethods.size() <= 12
        && data.serviceMethods[0] is string && data.serviceMethods[0].size() <= 32
        && data.projectLocation is string && data.projectLocation.size() >= 2 && data.projectLocation.size() <= 180
        && data.urgency in ['standard', 'priority', 'emergency_24h']
        && data.scopeSummary is string && data.scopeSummary.size() >= 5 && data.scopeSummary.size() <= 2000
        && data.status in ['new', 'under_review', 'approved', 'in_progress', 'completed', 'rejected']
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompanyRecord(data) {
      return data.keys().hasAll([
          'companyCode', 'nameAr', 'nameEn', 'archiveCategory',
          'hasActiveTestingDossier', 'sector', 'assignedClientUid',
          'reportsCount', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'companyCode', 'nameAr', 'nameEn', 'archiveCategory',
          'hasActiveTestingDossier', 'sector', 'commercialRegNo',
          'contactPerson', 'contactEmail', 'contactPhone',
          'projectLocation', 'activeScope', 'assignedClientUid',
          'legacySinceYear', 'reportsCount', 'siteLat', 'siteLng',
          'geofenceRadiusMeters', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && isValidCode(data.companyCode)
        && data.nameAr is string && data.nameAr.size() >= 2 && data.nameAr.size() <= 180
        && data.nameEn is string && data.nameEn.size() >= 2 && data.nameEn.size() <= 180
        && data.archiveCategory in ['active_testing', 'legacy_archive', 'new_onboarding']
        && data.hasActiveTestingDossier is bool
        && data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 100
        && (!('commercialRegNo' in data) || (data.commercialRegNo is string && data.commercialRegNo.size() <= 64))
        && (!('contactPerson' in data) || (data.contactPerson is string && data.contactPerson.size() <= 120))
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 160))
        && (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 40))
        && (!('projectLocation' in data) || (data.projectLocation is string && data.projectLocation.size() <= 180))
        && (!('activeScope' in data) || (data.activeScope is string && data.activeScope.size() <= 1500))
        && data.assignedClientUid is string && data.assignedClientUid.size() <= 128
        && (!('legacySinceYear' in data) || (data.legacySinceYear is string && data.legacySinceYear.size() <= 16))
        && data.reportsCount is number && data.reportsCount >= 0 && data.reportsCount <= 100000
        && (!('siteLat' in data) || (data.siteLat is number && data.siteLat >= -90 && data.siteLat <= 90))
        && (!('siteLng' in data) || (data.siteLng is number && data.siteLng <= 180 && data.siteLng >= -180))
        && (!('geofenceRadiusMeters' in data) || (data.geofenceRadiusMeters is number && data.geofenceRadiusMeters >= 50 && data.geofenceRadiusMeters <= 50000))
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompanyCodeReservation(data, codeId) {
      return data.keys().hasAll(['companyCode', 'companyId', 'createdByUid', 'createdAt'])
        && data.keys().hasOnly(['companyCode', 'companyId', 'createdByUid', 'createdAt'])
        && isValidCode(codeId)
        && data.companyCode == codeId
        && isValidId(data.companyId)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp;
    }

    function isValidInspectionReport(data, parentCompanyId) {
      return data.keys().hasAll([
          'companyId', 'companyCode', 'assignedClientUid', 'reportNumber',
          'templateKey', 'method', 'isLegacyArchive', 'projectName',
          'componentOrJointId', 'codeStandard', 'inspectorName',
          'inspectionDate', 'verdict', 'status', 'technicalData',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'companyId', 'companyCode', 'assignedClientUid', 'reportNumber',
          'templateKey', 'method', 'isLegacyArchive', 'projectName',
          'clientPoNumber', 'componentOrJointId', 'materialSpec',
          'thicknessMm', 'codeStandard', 'inspectorName', 'inspectionDate',
          'verdict', 'status', 'technicalData', 'notes',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.companyId) && data.companyId == parentCompanyId
        && isValidCode(data.companyCode)
        && data.assignedClientUid is string && data.assignedClientUid.size() <= 128
        && data.reportNumber is string && data.reportNumber.size() >= 3 && data.reportNumber.size() <= 64 && data.reportNumber.matches('^[A-Z0-9\\-/]+$')
        && data.templateKey is string && data.templateKey.size() >= 2 && data.templateKey.size() <= 64
        && data.method in ['RT', 'UT', 'PAUT', 'MT', 'PT', 'VT', 'PMI', 'PWHT', 'HYDRO', 'CUSTOM']
        && data.isLegacyArchive is bool
        && data.projectName is string && data.projectName.size() >= 2 && data.projectName.size() <= 180
        && (!('clientPoNumber' in data) || (data.clientPoNumber is string && data.clientPoNumber.size() <= 80))
        && data.componentOrJointId is string && data.componentOrJointId.size() >= 1 && data.componentOrJointId.size() <= 160
        && (!('materialSpec' in data) || (data.materialSpec is string && data.materialSpec.size() <= 100))
        && (!('thicknessMm' in data) || (data.thicknessMm is string && data.thicknessMm.size() <= 40))
        && data.codeStandard is string && data.codeStandard.size() >= 2 && data.codeStandard.size() <= 120
        && data.inspectorName is string && data.inspectorName.size() >= 2 && data.inspectorName.size() <= 120
        && data.inspectionDate is string && data.inspectionDate.size() >= 8 && data.inspectionDate.size() <= 20
        && data.verdict in ['ACCEPT', 'REJECT', 'HOLD', 'REVIEW']
        && data.status in ['draft', 'issued', 'archived']
        && data.technicalData is map && data.technicalData.size() <= 30
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompanyEmployee(data, parentCompanyId) {
      return data.keys().hasAll([
          'companyId', 'companyCode', 'ownerUid', 'fullName',
          'roleTitle', 'badgeCode', 'faceEnrolled', 'onlineStatus',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'companyId', 'companyCode', 'ownerUid', 'workerUid', 'fullName',
          'roleTitle', 'badgeCode', 'phone', 'faceEnrolled', 'faceDigest',
          'lastLat', 'lastLng', 'lastSeenAt', 'onlineStatus',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.companyId) && data.companyId == parentCompanyId
        && isValidCode(data.companyCode)
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && (!('workerUid' in data) || (data.workerUid is string && data.workerUid.size() <= 128))
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.roleTitle is string && data.roleTitle.size() >= 2 && data.roleTitle.size() <= 120
        && data.badgeCode is string && data.badgeCode.size() >= 2 && data.badgeCode.size() <= 40 && data.badgeCode.matches('^[A-Z0-9\\-]+$')
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.faceEnrolled is bool
        && (!('faceDigest' in data) || (data.faceDigest is string && data.faceDigest.size() <= 128))
        && (!('lastLat' in data) || (data.lastLat is number && data.lastLat >= -90 && data.lastLat <= 90))
        && (!('lastLng' in data) || (data.lastLng is number && data.lastLng >= -180 && data.lastLng <= 180))
        && (!('lastSeenAt' in data) || (data.lastSeenAt is string && data.lastSeenAt.size() <= 40))
        && data.onlineStatus in ['on_site', 'off_duty', 'in_transit', 'alert']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendanceLog(data, parentCompanyId) {
      return data.keys().hasAll([
          'companyId', 'companyCode', 'ownerUid', 'employeeId',
          'employeeName', 'workerUid', 'eventType', 'lat', 'lng',
          'distanceFromSiteMeters', 'geofenceRadiusMeters', 'geofenceStatus',
          'faceVerified', 'verificationMethod', 'timestampIso', 'createdAt'
        ])
        && data.keys().hasOnly([
          'companyId', 'companyCode', 'ownerUid', 'employeeId',
          'employeeName', 'workerUid', 'eventType', 'lat', 'lng',
          'accuracyMeters', 'distanceFromSiteMeters', 'geofenceRadiusMeters',
          'geofenceStatus', 'faceVerified', 'faceSnapshotHash',
          'verificationMethod', 'deviceLabel', 'notes', 'timestampIso', 'createdAt'
        ])
        && isValidId(data.companyId) && data.companyId == parentCompanyId
        && isValidCode(data.companyCode)
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && isValidId(data.employeeId)
        && data.employeeName is string && data.employeeName.size() >= 2 && data.employeeName.size() <= 120
        && isValidId(data.workerUid)
        && data.eventType in ['check_in', 'check_out']
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('accuracyMeters' in data) || (data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 50000))
        && data.distanceFromSiteMeters is number && data.distanceFromSiteMeters >= 0 && data.distanceFromSiteMeters <= 20000000
        && data.geofenceRadiusMeters is number && data.geofenceRadiusMeters >= 50 && data.geofenceRadiusMeters <= 50000
        && data.geofenceStatus in ['inside_geofence', 'outside_geofence']
        && data.faceVerified is bool
        && (!('faceSnapshotHash' in data) || (data.faceSnapshotHash is string && data.faceSnapshotHash.size() <= 128))
        && data.verificationMethod in ['face_gps', 'gps_only', 'manual_override']
        && (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.timestampIso is string && data.timestampIso.size() >= 10 && data.timestampIso.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidCommunityWorkspace(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'organizationName', 'sector',
          'companiesManaged', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'organizationName', 'sector', 'city',
          'companyCode', 'specialtyTrades', 'bio', 'companiesManaged',
          'isPublished', 'headline', 'certifications', 'yearsExperience',
          'availabilityStatus', 'followersCount', 'endorsementsCount',
          'photoURL', 'bannerURL', 'linkedInUrl', 'profileVisibility', 'skills',
          'professionalRole', 'relatedFields', 'languages',
          'experienceSummary', 'educationSummary', 'projectsSummary',
          'shareAcademyProgress', 'messagePolicy',
          'identityVerified', 'organizationVerified', 'credentialVerified',
          'verifiedOrganizationId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid) && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120
        && data.organizationName is string && data.organizationName.size() >= 2 && data.organizationName.size() <= 160
        && data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 100
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('companyCode' in data) || (data.companyCode is string && data.companyCode.size() <= 32))
        && (!('specialtyTrades' in data) || (data.specialtyTrades is string && data.specialtyTrades.size() <= 300))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 600))
        && (!('headline' in data) || (data.headline is string && data.headline.size() <= 160))
        && (!('certifications' in data) || (data.certifications is string && data.certifications.size() <= 240))
        && (!('yearsExperience' in data) || (data.yearsExperience is number && data.yearsExperience >= 0 && data.yearsExperience <= 70))
        && (!('skills' in data) || (
          data.skills is string
          && data.skills.size() <= 700
          && (data.skills == '' || data.skills.matches('^[a-z0-9_]{1,40}(,[a-z0-9_]{1,40}){0,19}$'))
        ))
        && (!('availabilityStatus' in data) || data.availabilityStatus in ['active_field', 'open_to_work', 'hiring', 'offering_services'])
        && (!('followersCount' in data) || (data.followersCount is number && data.followersCount >= 0 && data.followersCount <= 1000000))
        && (!('endorsementsCount' in data) || (data.endorsementsCount is number && data.endorsementsCount >= 0 && data.endorsementsCount <= 1000000))
        && data.companiesManaged is number && data.companiesManaged >= 0 && data.companiesManaged <= 10000
        && data.isPublished is bool
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.matches('https://.*') && data.photoURL.size() <= 500))
        && (!('bannerURL' in data) || (data.bannerURL is string && data.bannerURL.matches('https://.*') && data.bannerURL.size() <= 500))
        && (!('linkedInUrl' in data) || (
          data.linkedInUrl is string
          && data.linkedInUrl.matches('https://([a-z0-9-]+[.])*(linkedin[.]com|lnkd[.]in)/.*')
          && data.linkedInUrl.size() <= 500
        ))
        && (!('profileVisibility' in data) || data.profileVisibility in ['public', 'members'])
        && (!('professionalRole' in data) || (data.professionalRole is string && data.professionalRole.size() <= 60))
        && (!('relatedFields' in data) || (data.relatedFields is string && data.relatedFields.size() <= 400))
        && (!('languages' in data) || (data.languages is string && data.languages.size() <= 200))
        && (!('experienceSummary' in data) || (data.experienceSummary is string && data.experienceSummary.size() <= 1200))
        && (!('educationSummary' in data) || (data.educationSummary is string && data.educationSummary.size() <= 600))
        && (!('projectsSummary' in data) || (data.projectsSummary is string && data.projectsSummary.size() <= 800))
        && (!('shareAcademyProgress' in data) || data.shareAcademyProgress is bool)
        && (!('messagePolicy' in data) || data.messagePolicy in ['everyone', 'connections', 'none'])
        && (!('identityVerified' in data) || data.identityVerified is bool)
        && (!('organizationVerified' in data) || data.organizationVerified is bool)
        && (!('credentialVerified' in data) || data.credentialVerified is bool)
        && (!('verifiedOrganizationId' in data) || (data.verifiedOrganizationId is string && data.verifiedOrganizationId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'authorOrg', 'postType', 'ndtMethod',
          'title', 'body', 'likesCount', 'commentsCount', 'visibility',
          'aiModerationStatus', 'isPinnedAnnouncement', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorUid', 'authorName', 'authorHeadline', 'authorOrg', 'authorCompanyCode',
          'postType', 'ndtMethod', 'title', 'body', 'tags', 'technicalSnippet',
          'aiSummary', 'likesCount', 'commentsCount', 'visibility',
          'aiModerationStatus', 'isPinnedAnnouncement',
          'categoryTag', 'mediaUrl', 'documentUrl', 'linkUrl',
          'academyCourseId', 'academyCourseTitle', 'pollOptions',
          'companyId', 'companyName', 'groupId', 'isAiAssisted',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && (!('authorHeadline' in data) || (data.authorHeadline is string && data.authorHeadline.size() <= 160))
        && data.authorOrg is string && data.authorOrg.size() >= 2 && data.authorOrg.size() <= 160
        && (!('authorCompanyCode' in data) || (data.authorCompanyCode is string && data.authorCompanyCode.size() <= 32))
        && data.postType in ['technical_case', 'job_tender', 'discussion', 'equipment_review', 'announcement']
        && data.ndtMethod in ['GENERAL', 'RT', 'UT', 'PAUT', 'TOFD', 'MT', 'PT', 'VT', 'ET', 'PWHT', 'AR']
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 180
        && data.body is string && data.body.size() >= 5 && data.body.size() <= 3000
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 6 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 32))))
        && (!('technicalSnippet' in data) || (data.technicalSnippet is string && data.technicalSnippet.size() <= 600))
        && (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 800))
        && data.likesCount is number && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.commentsCount is number && data.commentsCount >= 0 && data.commentsCount <= 1000000
        && data.visibility in ['public', 'members_only']
        && data.aiModerationStatus in ['approved', 'flagged']
        && data.isPinnedAnnouncement is bool
        && (!('categoryTag' in data) || data.categoryTag in ['general', 'article', 'question', 'case_study', 'media', 'poll', 'job', 'company_update', 'academy', 'event'])
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.matches('https://.*') && data.mediaUrl.size() <= 500))
        && (!('documentUrl' in data) || (data.documentUrl is string && data.documentUrl.matches('https://.*') && data.documentUrl.size() <= 500))
        && (!('linkUrl' in data) || (data.linkUrl is string && data.linkUrl.matches('https://.*') && data.linkUrl.size() <= 500))
        && (!('academyCourseId' in data) || (data.academyCourseId is string && data.academyCourseId.size() <= 80))
        && (!('academyCourseTitle' in data) || (data.academyCourseTitle is string && data.academyCourseTitle.size() <= 180))
        && (!('pollOptions' in data) || (data.pollOptions is list && data.pollOptions.size() <= 6))
        && (!('companyId' in data) || (data.companyId is string && data.companyId.size() <= 128))
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 160))
        && (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 128))
        && (!('isAiAssisted' in data) || data.isAiAssisted is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityComment(data, parentPostId) {
      return data.keys().hasAll([
          'postId', 'authorUid', 'authorName', 'body', 'isAiAssisted', 'createdAt'
        ])
        && data.keys().hasOnly([
          'postId', 'authorUid', 'authorName', 'authorHeadline',
          'parentCommentId', 'body', 'isAiAssisted', 'createdAt'
        ])
        && isValidId(data.postId) && data.postId == parentPostId
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && (!('authorHeadline' in data) || (data.authorHeadline is string && data.authorHeadline.size() <= 160))
        && (!('parentCommentId' in data) || (data.parentCommentId is string && data.parentCommentId.size() <= 128))
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 1500
        && data.isAiAssisted is bool
        && data.createdAt is timestamp;
    }

    function isValidCommunityReaction(data, parentPostId, userId) {
      return data.keys().hasAll(['postId', 'uid', 'reactionType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['postId', 'uid', 'reactionType', 'createdAt', 'updatedAt'])
        && isValidId(data.postId) && data.postId == parentPostId
        && isValidId(data.uid) && data.uid == userId
        && data.reactionType in ['like', 'insightful', 'verified', 'celebrate']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityConnection(data, connectionId) {
      return data.keys().hasAll([
          'fromUid', 'toUid', 'fromName', 'toName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fromUid', 'toUid', 'fromName', 'toName', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.fromUid)
        && isValidId(data.toUid)
        && data.fromUid != data.toUid
        && connectionId == (data.fromUid + '_' + data.toUid)
        && data.fromName is string && data.fromName.size() >= 2 && data.fromName.size() <= 120
        && data.toName is string && data.toName.size() >= 2 && data.toName.size() <= 120
        && data.status in ['connected', 'pending']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Engineering Network Groups: owner-chosen join and posting policies
    // -------------------------------------------------------------------------
    function groupData(groupId) {
      return get(/databases/$(database)/documents/community_groups/$(groupId)).data;
    }

    function groupMemberId(groupId, uid) {
      return groupId + '_' + uid;
    }

    function groupMemberData(groupId, uid) {
      return get(/databases/$(database)/documents/community_group_members/$(groupMemberId(groupId, uid))).data;
    }

    function isGroupOwnerOf(groupId) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/community_groups/$(groupId))
        && groupData(groupId).ownerUid == request.auth.uid;
    }

    function isApprovedGroupMember(groupId) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/community_groups/$(groupId))
        && exists(/databases/$(database)/documents/community_group_members/$(groupMemberId(groupId, request.auth.uid)))
        && groupMemberData(groupId, request.auth.uid).status == 'approved';
    }

    function isValidCommunityGroup(data) {
      return data.keys().hasAll([
          'name', 'description', 'ownerUid', 'ownerName',
          'joinPolicy', 'postPolicy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'description', 'ownerUid', 'ownerName',
          'joinPolicy', 'postPolicy', 'coverURL', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 120
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1200
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 120
        && data.joinPolicy in ['open', 'request', 'invite']
        && data.postPolicy in ['members', 'owners']
        && (!('coverURL' in data) || (
          data.coverURL is string && data.coverURL.matches('https://.*') && data.coverURL.size() <= 500
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGroupMember(data) {
      return data.keys().hasAll(['groupId', 'uid', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['groupId', 'uid', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.groupId is string && data.groupId.size() >= 1 && data.groupId.size() <= 128
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120
        && data.role in ['owner', 'member']
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGroupPost(data) {
      return data.keys().hasAll(['authorUid', 'authorName', 'body', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorUid', 'authorName', 'authorHeadline', 'title', 'body', 'createdAt', 'updatedAt'])
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && (!('authorHeadline' in data) || (data.authorHeadline is string && data.authorHeadline.size() <= 160))
        && (!('title' in data) || (data.title is string && data.title.size() >= 3 && data.title.size() <= 160))
        && data.body is string && data.body.size() >= 5 && data.body.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityOpportunity(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'authorOrg', 'opportunityType',
          'title', 'location', 'methods', 'requirements',
          'status', 'visibility', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorUid', 'authorName', 'authorOrg', 'companyCode',
          'opportunityType', 'title', 'location', 'methods',
          'requirements', 'employmentType', 'experienceLevel',
          'salaryRange', 'companyId', 'status', 'visibility', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && data.authorOrg is string && data.authorOrg.size() >= 2 && data.authorOrg.size() <= 160
        && (!('companyCode' in data) || (data.companyCode is string && data.companyCode.size() <= 32))
        && data.opportunityType in ['job', 'tender', 'equipment']
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 180
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 140
        && data.methods is list && data.methods.size() >= 1 && data.methods.size() <= 8
        && data.methods[0] is string && data.methods[0].size() <= 32
        && data.requirements is string && data.requirements.size() >= 5 && data.requirements.size() <= 1500
        && (!('employmentType' in data) || data.employmentType in ['full_time', 'part_time', 'contract', 'shutdown', 'freelance', 'internship', 'training', 'project_based'])
        && (!('experienceLevel' in data) || (data.experienceLevel is string && data.experienceLevel.size() <= 80))
        && (!('salaryRange' in data) || (data.salaryRange is string && data.salaryRange.size() <= 80))
        && (!('companyId' in data) || (data.companyId is string && data.companyId.size() <= 128))
        && data.status in ['open', 'closed']
        && data.visibility in ['public']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidModuleProgress(data) {
      return data.keys().hasAll(['userId', 'moduleId'])
        && data.keys().hasOnly([
          'userId', 'moduleId', 'disciplineId', 'completedTopics',
          'completedCount', 'updatedAt', 'clientTimestamp',
          'isPassed', 'score', 'unlockedCertificate', 'completedAt'
        ])
        && isValidId(data.userId)
        && data.moduleId is string && data.moduleId.matches('^[a-zA-Z0-9_-]{1,80}$')
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp)
        && (!('disciplineId' in data) || (data.disciplineId is string && data.disciplineId.size() <= 80))
        && (!('completedTopics' in data) || (data.completedTopics is list && data.completedTopics.size() <= 200))
        && (!('completedCount' in data) || (data.completedCount is number && data.completedCount >= 0 && data.completedCount <= 200))
        && (!('clientTimestamp' in data) || (data.clientTimestamp is string && data.clientTimestamp.size() <= 40))
        && (!('isPassed' in data) || data.isPassed is bool)
        && (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 100))
        && (!('unlockedCertificate' in data) || data.unlockedCertificate is bool);
    }

    function isValidQuizLeaderboardEntry(data) {
      return data.keys().hasAll(['studentName', 'disciplineId', 'percentage', 'score'])
        && data.keys().hasOnly(['studentName', 'disciplineId', 'percentage', 'score', 'badgeUnlocked', 'timestamp'])
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100
        && data.disciplineId is string && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && data.percentage is number && data.percentage >= 0 && data.percentage <= 100
        && data.score is number && data.score >= 0 && data.score <= 1000
        && (!('badgeUnlocked' in data) || data.badgeUnlocked == null || (data.badgeUnlocked is string && data.badgeUnlocked.size() <= 80));
    }

    // -------------------------------------------------------------------------
    // Admins Registry
    // -------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdminEmail());
      allow list: if isAdminEmail();
      allow create, update, delete: if isValidId(adminUid) && isAdminEmail();
    }

    // -------------------------------------------------------------------------
    // Private account reviews: administrator-managed permission, exact subject,
    // append-only reason and case ID, short server-timed authorization.
    // -------------------------------------------------------------------------
    function isAccountReviewer() {
      return isSignedIn() && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/account_reviewers/$(request.auth.uid)).data.enabled == true;
    }

    function hasAccountReview(userId) {
      let grant = get(/databases/$(database)/documents/account_review_access/$(request.auth.uid)).data;
      return grant.subjectUid == userId && grant.createdAt + duration.value(5, 'm') > request.time;
    }

    function isAccountReviewEvent(data) {
      return data.keys().hasAll(['reviewerUid', 'subjectUid', 'caseReference', 'reason', 'createdAt'])
        && data.keys().hasOnly(['reviewerUid', 'subjectUid', 'caseReference', 'reason', 'createdAt'])
        && data.reviewerUid == request.auth.uid
        && isValidId(data.subjectUid) && data.subjectUid != data.reviewerUid
        && data.caseReference is string && data.caseReference.matches('^[a-zA-Z0-9-]{4,40}$')
        && data.reason in ['account_support', 'company_link', 'data_request']
        && data.createdAt == request.time;
    }

    function isAccountReviewGrant(data) {
      let event = getAfter(/databases/$(database)/documents/account_review_audit/$(data.auditId)).data;
      return !exists(/databases/$(database)/documents/account_review_audit/$(data.auditId))
        && event.reviewerUid == request.auth.uid && event.subjectUid == data.subjectUid
        && event.createdAt == request.time && data.createdAt == request.time;
    }

    function hasCompanyLinkReview(userId) {
      let grant = get(/databases/$(database)/documents/account_review_access/$(request.auth.uid)).data;
      return grant.subjectUid == userId && grant.createdAt + duration.value(5, 'm') > request.time
        && get(/databases/$(database)/documents/account_review_audit/$(grant.auditId)).data.reason == 'company_link';
    }

    // Membership is assigned/revoked only by a trusted operator using IAM.
    match /account_reviewers/{reviewerUid} {
      allow get: if isOwner(reviewerUid) && request.auth.token.email_verified == true;
    }

    match /account_review_audit/{auditId} {
      allow create: if isValidId(auditId) && isAccountReviewer() && isAccountReviewEvent(incoming())
        && getAfter(/databases/$(database)/documents/account_review_access/$(request.auth.uid)).data.auditId == auditId;
      // No browser reads, updates, or deletes, including by reviewers.
      // Audit supervisors access the collection through separately granted IAM.
    }

    match /account_review_access/{reviewerUid} {
      allow create, update: if isOwner(reviewerUid) && isAccountReviewer()
        && incoming().keys().hasAll(['auditId', 'subjectUid', 'createdAt'])
        && incoming().keys().hasOnly(['auditId', 'subjectUid', 'createdAt'])
        && isValidId(incoming().auditId) && isValidId(incoming().subjectUid)
        && isAccountReviewGrant(incoming());
    }

    // No browser-side bulk reads of private profiles, even for administrators.
    match /client_accounts/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser()
        && (isOwner(userId) || (isAccountReviewer() && hasAccountReview(userId)));

      allow create: if isVerifiedUser() && isOwner(userId)
        && isValidId(userId)
        && isValidClientAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'client' && incoming().approvalStatus == 'pending'
          || (isAdminEmail() && incoming().role == 'admin' && incoming().approvalStatus == 'approved'))
        && (!('assignedCompanyId' in incoming()) || incoming().assignedCompanyId == '')
        && (!('assignedCompanyCode' in incoming()) || incoming().assignedCompanyCode == '');

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidClientAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'email', 'phone', 'organizationName', 'requestedCompanyCode', 'sector',
            'jobTitle', 'nationalId', 'secondaryPhone', 'personalAddress',
            'organizationNameEn', 'commercialRegNo', 'taxCardNo',
            'companyPhone', 'companyEmail', 'website', 'companyAddress',
            'cityGovernorate', 'activeScope', 'updatedAt'
          ]))
          || (isAccountReviewer() && isAdmin() && hasCompanyLinkReview(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'approvalStatus', 'assignedCompanyId', 'assignedCompanyCode', 'updatedAt'
            ]))
        );
    }

    // -------------------------------------------------------------------------
    // Opt-In Public Community Business Directory (Zero PII)
    // -------------------------------------------------------------------------
    match /community_workspaces/{userId} {
      // The member page at `#network/people/<uid>` reads this one document. A card
      // marked «للأعضاء المؤكَّدين» is refused to a signed-out reader here — that is
      // the enforcement, not a hidden button. Absence of the field means public.
      allow get: if isValidId(userId) && (
        isAdmin()
        || isOwner(userId)
        || (
          existing().isPublished == true
          && (!('profileVisibility' in existing()) || existing().profileVisibility == 'public' || isVerifiedUser())
        )
      );
      allow list: if existing().isPublished == true || isAdminEmail() || (isVerifiedUser() && existing().uid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidCommunityWorkspace(incoming(), userId)
        && (!('identityVerified' in incoming()) || incoming().identityVerified == false)
        && (!('organizationVerified' in incoming()) || incoming().organizationVerified == false)
        && (!('credentialVerified' in incoming()) || incoming().credentialVerified == false)
        && (!('verifiedOrganizationId' in incoming()) || incoming().verifiedOrganizationId == '')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidCommunityWorkspace(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && !incoming().diff(existing()).affectedKeys().hasAny([
              'identityVerified', 'organizationVerified', 'credentialVerified',
              'verifiedOrganizationId', 'uid', 'createdAt'
            ])
          )
          || incoming().diff(existing()).affectedKeys().hasOnly(['endorsementsCount', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Peer Endorsements — one document per (endorsee × skill × endorser)
    // -------------------------------------------------------------------------
    // The document id is `toUid_skillId_fromUid`, so a member cannot endorse the
    // same skill twice: the second write lands on the same document. Nobody may
    // endorse themselves, and the name is echoed only so the list can render
    // without an extra read. An endorsement is a peer signal, not a certificate —
    // nothing here touches the certificate verification path.
    match /community_endorsements/{endorsementId} {
      allow get, list: if isVerifiedUser();

      allow create: if isVerifiedUser()
        && isValidId(endorsementId)
        && request.resource.data.keys().hasAll(['toUid', 'fromUid', 'skillId', 'fromName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['toUid', 'fromUid', 'skillId', 'fromName', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && isValidId(request.resource.data.toUid)
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.skillId is string
        && request.resource.data.skillId.size() >= 1
        && request.resource.data.skillId.size() <= 40
        && request.resource.data.skillId.matches('^[a-z0-9_]+$')
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 120
        && endorsementId == request.resource.data.toUid + '_' + request.resource.data.skillId + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Withdrawing is the endorser's call alone: nobody can strip someone else's
      // endorsement, and the endorsee cannot accumulate or delete them either.
      allow delete: if isVerifiedUser() && existing().fromUid == request.auth.uid;

      allow update: if false;
    }

    // -------------------------------------------------------------------------
    // Written Recommendations — one document per (author × subject)
    // -------------------------------------------------------------------------
    // The id is `fromUid_toUid`, so a member writes at most one recommendation
    // about another member and edits that one. The subject may delete it (their
    // own page shows it) but cannot rewrite the words. Dates are split on purpose:
    // `createdAt` must survive an edit, otherwise a rewrite would be laundered as
    // a fresh testimonial.
    match /community_recommendations/{recommendationId} {
      allow get, list: if isVerifiedUser();

      allow create: if isVerifiedUser()
        && isValidId(recommendationId)
        && request.resource.data.keys().hasAll([
          'fromUid', 'fromName', 'toUid', 'toName', 'relation', 'body', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fromUid', 'fromName', 'toUid', 'toName', 'relation', 'body', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && isValidId(request.resource.data.toUid)
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 120
        && request.resource.data.toName is string
        && request.resource.data.toName.size() <= 120
        && request.resource.data.relation in ['colleague', 'client', 'instructor']
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 40
        && request.resource.data.body.size() <= 1200
        && recommendationId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isVerifiedUser()
        && existing().fromUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'fromUid', 'fromName', 'toUid', 'toName', 'relation', 'body', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fromUid', 'fromName', 'toUid', 'toName', 'relation', 'body', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.fromUid == existing().fromUid
        && request.resource.data.toUid == existing().toUid
        && request.resource.data.createdAt == existing().createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.relation in ['colleague', 'client', 'instructor']
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 40
        && request.resource.data.body.size() <= 1200;

      // Author or subject. The subject cannot edit, only take it down.
      allow delete: if isVerifiedUser()
        && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // INSCO Community Feed Posts, Comments & Reactions (Zero PII)
    // -------------------------------------------------------------------------
    match /community_posts/{postId} {
      allow get: if isValidId(postId) && (
        existing().visibility == 'public'
        || isAdmin()
        || (isVerifiedUser() && existing().authorUid == request.auth.uid)
      );
      allow list: if existing().visibility == 'public'
        || isAdminEmail()
        || (isVerifiedUser() && existing().authorUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(postId)
        && isValidCommunityPost(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().aiModerationStatus == 'approved'
        && (isAdmin() || incoming().isPinnedAnnouncement == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(postId)
        && isValidCommunityPost(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().authorUid == request.auth.uid
            && incoming().isPinnedAnnouncement == existing().isPinnedAnnouncement
            && incoming().aiModerationStatus == existing().aiModerationStatus
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'authorHeadline', 'authorOrg', 'authorCompanyCode',
              'postType', 'ndtMethod', 'title', 'body', 'tags',
              'technicalSnippet', 'aiSummary', 'visibility',
              'categoryTag', 'mediaUrl', 'documentUrl', 'linkUrl',
              'academyCourseId', 'academyCourseTitle', 'pollOptions',
              'companyId', 'companyName', 'groupId', 'isAiAssisted',
              'updatedAt'
            ])
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1)
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && incoming().commentsCount == existing().commentsCount + 1
          )
        );

      allow delete: if isValidId(postId)
        && (isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));

      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId);
        allow list: if isValidId(postId);

        allow create: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/community_posts/$(postId))
          && isValidCommunityComment(incoming(), postId)
          && incoming().authorUid == request.auth.uid
          && incoming().createdAt == request.time;

        allow update: if false;
        allow delete: if isValidId(postId) && isValidId(commentId)
          && (isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));
      }

      match /reactions/{userId} {
        allow get: if isValidId(postId) && isValidId(userId);
        allow list: if isValidId(postId);

        allow create, update: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(userId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/community_posts/$(postId))
          && isValidCommunityReaction(incoming(), postId, userId)
          && incoming().updatedAt == request.time;

        allow delete: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(userId)
          && (isOwner(userId) || isAdmin());
      }

      match /answers/{answerId} {
        allow get: if isValidId(postId) && isValidId(answerId);
        allow list: if isValidId(postId);

        allow create: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(answerId)
          && exists(/databases/$(database)/documents/community_posts/$(postId))
          && incoming().keys().hasAll(['postId', 'authorUid', 'authorName', 'body', 'upvotesCount', 'isAccepted', 'expertReviewed', 'isAiAssisted', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['postId', 'authorUid', 'authorName', 'authorHeadline', 'body', 'references', 'academyCourseId', 'upvotesCount', 'isAccepted', 'expertReviewed', 'reviewerUid', 'reviewerName', 'isAiAssisted', 'createdAt', 'updatedAt'])
          && incoming().postId == postId
          && incoming().authorUid == request.auth.uid
          && incoming().authorName is string && incoming().authorName.size() >= 2 && incoming().authorName.size() <= 120
          && incoming().body is string && incoming().body.size() >= 5 && incoming().body.size() <= 3000
          && (!('authorHeadline' in incoming()) || (incoming().authorHeadline is string && incoming().authorHeadline.size() <= 160))
          && (!('references' in incoming()) || (incoming().references is string && incoming().references.size() <= 500))
          && (!('academyCourseId' in incoming()) || (incoming().academyCourseId is string && incoming().academyCourseId.size() <= 80))
          && incoming().upvotesCount == 0
          && incoming().isAccepted == false
          && incoming().expertReviewed == false
          && !('reviewerUid' in incoming())
          && !('reviewerName' in incoming())
          && incoming().isAiAssisted is bool
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(answerId)
          && incoming().postId == existing().postId
          && incoming().authorUid == existing().authorUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              existing().authorUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['body', 'references', 'academyCourseId', 'updatedAt'])
              && incoming().body is string && incoming().body.size() >= 5 && incoming().body.size() <= 3000
            )
            || (
              get(/databases/$(database)/documents/community_posts/$(postId)).data.authorUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['isAccepted', 'updatedAt'])
              && incoming().isAccepted is bool
            )
            || (
              incoming().diff(existing()).affectedKeys().hasOnly(['expertReviewed', 'reviewerUid', 'reviewerName', 'updatedAt'])
              && incoming().expertReviewed is bool
              && incoming().reviewerUid == request.auth.uid
              && incoming().reviewerName is string && incoming().reviewerName.size() >= 2 && incoming().reviewerName.size() <= 120
            )
            || (
              incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'updatedAt'])
              && (incoming().upvotesCount == existing().upvotesCount + 1 || incoming().upvotesCount == existing().upvotesCount - 1)
            )
          );

        allow delete: if isValidId(postId) && isValidId(answerId)
          && (isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));

        match /votes/{userId} {
          allow get: if isValidId(postId) && isValidId(answerId) && isValidId(userId);
          allow list: if isValidId(postId) && isValidId(answerId);
          allow create: if isVerifiedUser() && isOwner(userId)
            && incoming().keys().hasAll(['uid', 'createdAt'])
            && incoming().keys().hasOnly(['uid', 'createdAt'])
            && incoming().uid == request.auth.uid
            && incoming().createdAt == request.time;
          allow delete: if isVerifiedUser() && (isOwner(userId) || isAdmin());
        }
      }

      match /poll_votes/{userId} {
        allow get: if isValidId(postId) && isValidId(userId);
        allow list: if isValidId(postId);
        allow create: if isVerifiedUser() && isOwner(userId)
          && incoming().keys().hasAll(['postId', 'uid', 'optionIndex', 'createdAt'])
          && incoming().keys().hasOnly(['postId', 'uid', 'optionIndex', 'createdAt'])
          && incoming().postId == postId
          && incoming().uid == request.auth.uid
          && incoming().optionIndex is number && incoming().optionIndex >= 0 && incoming().optionIndex <= 5
          && incoming().createdAt == request.time;
        allow delete: if isVerifiedUser() && (isOwner(userId) || isAdmin());
      }
    }

    // -------------------------------------------------------------------------
    // LinkedIn-Style Member Network Connections
    // -------------------------------------------------------------------------
    match /community_connections/{connectionId} {
      allow get: if isVerifiedUser()
        && isValidId(connectionId)
        && (isAdmin() || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow list: if isAdminEmail()
        || (isVerifiedUser() && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid));

      allow create: if isVerifiedUser()
        && isValidId(connectionId)
        && isValidCommunityConnection(incoming(), connectionId)
        && incoming().fromUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(connectionId)
        && isValidCommunityConnection(incoming(), connectionId)
        && incoming().fromUid == existing().fromUid
        && incoming().toUid == existing().toUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);

      allow delete: if isVerifiedUser()
        && isValidId(connectionId)
        && (isAdmin() || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // LinkedIn-Style NDT Jobs, Tenders & Subcontracting Board (Zero PII)
    // -------------------------------------------------------------------------
    match /community_opportunities/{opportunityId} {
      allow get: if isValidId(opportunityId)
        && (existing().visibility == 'public' || isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));
      allow list: if existing().visibility == 'public'
        || isAdminEmail()
        || (isVerifiedUser() && existing().authorUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(opportunityId)
        && isValidCommunityOpportunity(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(opportunityId)
        && isValidCommunityOpportunity(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || existing().authorUid == request.auth.uid);

      allow delete: if isValidId(opportunityId)
        && (isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Engineering Network Groups
    //
    // A group belongs to the member who created it, and *that member* chooses how
    // people join (open / by request / by invitation) and who may post (every
    // approved member, or the owner alone). Both choices are enforced here, so a
    // closed group is closed in the database and not merely in the interface.
    // -------------------------------------------------------------------------
    match /community_groups/{groupId} {
      allow get: if isValidId(groupId);
      // The group list is public on purpose: name, description and the two policies
      // are institutional information, carry no personal data, and a visitor must be
      // able to see what exists before signing in to join.
      allow list: if true;

      allow create: if isVerifiedUser()
        && isValidId(groupId)
        && isValidCommunityGroup(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(groupId)
        && isValidCommunityGroup(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().ownerName == existing().ownerName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        // Only the owner edits the group. There are no counters here to drift.
        && (isAdmin() || existing().ownerUid == request.auth.uid);

      allow delete: if isVerifiedUser()
        && isValidId(groupId)
        && existing().ownerUid == request.auth.uid;
    }

    match /community_group_members/{memberId} {
      allow get: if isValidId(memberId) && (
        isAdmin()
        || (isSignedIn() && existing().uid == request.auth.uid)
        || isVerifiedUser()
      );
      allow list: if isVerifiedUser() || isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(memberId)
        && isValidGroupMember(incoming())
        && memberId == incoming().groupId + '_' + incoming().uid
        && exists(/databases/$(database)/documents/community_groups/$(incoming().groupId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          // The owner's own row, written with the group.
          (
            incoming().role == 'owner'
            && incoming().status == 'approved'
            && incoming().uid == request.auth.uid
            && groupData(incoming().groupId).ownerUid == request.auth.uid
          )
          // Joining an open group is immediate; a request-only group takes a request.
          || (
            incoming().role == 'member'
            && incoming().uid == request.auth.uid
            && (
              (groupData(incoming().groupId).joinPolicy == 'open' && incoming().status == 'approved')
              || (groupData(incoming().groupId).joinPolicy == 'request' && incoming().status == 'pending')
            )
          )
          // An invitation-only group is joined by its owner, not by the visitor.
          || (
            incoming().role == 'member'
            && incoming().status == 'approved'
            && groupData(incoming().groupId).joinPolicy == 'invite'
            && groupData(incoming().groupId).ownerUid == request.auth.uid
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(memberId)
        && isValidGroupMember(incoming())
        && incoming().uid == existing().uid
        && incoming().groupId == existing().groupId
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        // The owner answers a request. A member can never approve themselves.
        && (
          isAdmin()
          || (
            isGroupOwnerOf(existing().groupId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status in ['approved', 'rejected']
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(memberId)
        && (
          isAdmin()
          || existing().uid == request.auth.uid
          || isGroupOwnerOf(existing().groupId)
        );
    }

    // A group's own feed. Nothing here touches the public network feed: a post
    // written for a closed group stays in that group's subcollection.
    match /community_groups/{groupId}/posts/{postId} {
      // Reading requires an approved membership — a non-member is refused by the
      // rules, and the page says so instead of showing an empty group.
      allow get: if isValidId(groupId) && isValidId(postId) && (isApprovedGroupMember(groupId) || isAdmin());
      allow list: if isApprovedGroupMember(groupId) || isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(postId)
        && isValidGroupPost(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isApprovedGroupMember(groupId)
        // The owner's second choice: members may post, or the owner alone may.
        && (groupData(groupId).postPolicy == 'members' || groupData(groupId).ownerUid == request.auth.uid);

      allow update: if isVerifiedUser()
        && isValidId(postId)
        && isValidGroupPost(incoming())
        && incoming().authorUid == existing().authorUid
        && existing().authorUid == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isVerifiedUser()
        && (
          existing().authorUid == request.auth.uid
          || isGroupOwnerOf(groupId)
          || isAdmin()
        );
    }

    match /community_groups/{groupId}/resources/{resourceId} {
      allow get: if isValidId(groupId) && isValidId(resourceId) && (isApprovedGroupMember(groupId) || isAdmin());
      allow list: if isApprovedGroupMember(groupId) || isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(groupId)
        && isValidId(resourceId)
        && isApprovedGroupMember(groupId)
        && (groupData(groupId).postPolicy == 'members' || groupData(groupId).ownerUid == request.auth.uid)
        && incoming().keys().hasAll(['groupId', 'authorUid', 'authorName', 'kind', 'title', 'description', 'createdAt'])
        && incoming().keys().hasOnly(['groupId', 'authorUid', 'authorName', 'kind', 'title', 'description', 'url', 'eventDateIso', 'createdAt'])
        && incoming().groupId == groupId
        && incoming().authorUid == request.auth.uid
        && incoming().authorName is string && incoming().authorName.size() >= 2 && incoming().authorName.size() <= 120
        && incoming().kind in ['document', 'announcement', 'event']
        && incoming().title is string && incoming().title.size() >= 3 && incoming().title.size() <= 160
        && incoming().description is string && incoming().description.size() >= 3 && incoming().description.size() <= 1000
        && (!('url' in incoming()) || (incoming().url is string && incoming().url.matches('https://.*') && incoming().url.size() <= 500))
        && (!('eventDateIso' in incoming()) || (incoming().eventDateIso is string && incoming().eventDateIso.size() <= 40))
        && incoming().createdAt == request.time;
      allow delete: if isVerifiedUser() && (existing().authorUid == request.auth.uid || isGroupOwnerOf(groupId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // INSCO Professional Network Companies, Org Charts & Employee Consent
    // -------------------------------------------------------------------------
    match /community_companies/{companyId} {
      allow get: if isValidId(companyId);
      allow list: if true;

      allow create: if isVerifiedUser()
        && isValidId(companyId)
        && incoming().keys().hasAll(['ownerUid', 'name', 'industry', 'description', 'verificationStatus', 'followersCount', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['ownerUid', 'name', 'nameAr', 'industry', 'description', 'headquarters', 'branches', 'website', 'contactEmail', 'services', 'specializations', 'projectsSummary', 'logoURL', 'coverURL', 'verificationStatus', 'followersCount', 'createdAt', 'updatedAt'])
        && incoming().ownerUid == request.auth.uid
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 160
        && (!('nameAr' in incoming()) || (incoming().nameAr is string && incoming().nameAr.size() <= 160))
        && incoming().industry is string && incoming().industry.size() >= 2 && incoming().industry.size() <= 120
        && incoming().description is string && incoming().description.size() >= 5 && incoming().description.size() <= 1500
        && (!('headquarters' in incoming()) || (incoming().headquarters is string && incoming().headquarters.size() <= 160))
        && (!('branches' in incoming()) || (incoming().branches is string && incoming().branches.size() <= 400))
        && (!('website' in incoming()) || (incoming().website is string && incoming().website.size() <= 300))
        && (!('contactEmail' in incoming()) || (incoming().contactEmail is string && incoming().contactEmail.size() <= 160))
        && (!('services' in incoming()) || (incoming().services is string && incoming().services.size() <= 500))
        && (!('specializations' in incoming()) || (incoming().specializations is string && incoming().specializations.size() <= 400))
        && (!('projectsSummary' in incoming()) || (incoming().projectsSummary is string && incoming().projectsSummary.size() <= 1000))
        && (!('logoURL' in incoming()) || (incoming().logoURL is string && incoming().logoURL.matches('https://.*') && incoming().logoURL.size() <= 500))
        && (!('coverURL' in incoming()) || (incoming().coverURL is string && incoming().coverURL.matches('https://.*') && incoming().coverURL.size() <= 500))
        && (isAdmin() || incoming().verificationStatus in ['unverified', 'pending'])
        && incoming().followersCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(companyId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerUid == request.auth.uid
            && !incoming().diff(existing()).affectedKeys().hasAny(['ownerUid', 'verificationStatus', 'followersCount', 'createdAt'])
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
            && (incoming().followersCount == existing().followersCount + 1 || incoming().followersCount == existing().followersCount - 1)
          )
        );

      allow delete: if isValidId(companyId) && (isAdmin() || (isVerifiedUser() && existing().ownerUid == request.auth.uid));

      match /departments/{deptId} {
        allow get, list: if isValidId(companyId);

        allow create, update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(deptId)
          && exists(/databases/$(database)/documents/community_companies/$(companyId))
          && (isAdmin() || get(/databases/$(database)/documents/community_companies/$(companyId)).data.ownerUid == request.auth.uid)
          && incoming().keys().hasAll(['companyId', 'levelRank', 'levelTitle', 'name', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['companyId', 'parentDeptId', 'levelRank', 'levelTitle', 'name', 'description', 'managerUid', 'managerName', 'specializations', 'services', 'projectsSummary', 'createdAt', 'updatedAt'])
          && incoming().companyId == companyId
          && incoming().levelRank is number && incoming().levelRank >= 0 && incoming().levelRank <= 20
          && incoming().levelTitle is string && incoming().levelTitle.size() >= 2 && incoming().levelTitle.size() <= 80
          && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 120
          && incoming().updatedAt == request.time;

        allow delete: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(deptId)
          && (isAdmin() || get(/databases/$(database)/documents/community_companies/$(companyId)).data.ownerUid == request.auth.uid);
      }

      match /affiliations/{affiliationId} {
        allow get: if isValidId(companyId) && isValidId(affiliationId);
        allow list: if isValidId(companyId);

        // Company owner invites an employee (forced 'invited'); employee CANNOT force 'accepted' on create.
        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(affiliationId)
          && exists(/databases/$(database)/documents/community_companies/$(companyId))
          && (isAdmin() || get(/databases/$(database)/documents/community_companies/$(companyId)).data.ownerUid == request.auth.uid)
          && incoming().keys().hasAll(['companyId', 'companyName', 'employeeUid', 'employeeName', 'roleTitle', 'status', 'invitedByUid', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['companyId', 'companyName', 'employeeUid', 'employeeName', 'roleTitle', 'departmentId', 'departmentName', 'status', 'invitedByUid', 'createdAt', 'updatedAt'])
          && incoming().companyId == companyId
          && affiliationId == (companyId + '_' + incoming().employeeUid)
          && isValidId(incoming().employeeUid)
          && incoming().invitedByUid == request.auth.uid
          && incoming().status == 'invited'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        // Only the target employee may accept or decline affiliation.
        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(affiliationId)
          && incoming().companyId == existing().companyId
          && incoming().employeeUid == existing().employeeUid
          && incoming().invitedByUid == existing().invitedByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              existing().employeeUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              && incoming().status in ['accepted', 'declined']
            )
            || (
              get(/databases/$(database)/documents/community_companies/$(companyId)).data.ownerUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['roleTitle', 'departmentId', 'departmentName', 'status', 'updatedAt'])
              && incoming().status == 'removed'
            )
            || isAdmin()
          );

        allow delete: if isVerifiedUser()
          && (isAdmin() || existing().employeeUid == request.auth.uid || get(/databases/$(database)/documents/community_companies/$(companyId)).data.ownerUid == request.auth.uid);
      }
    }

    // -------------------------------------------------------------------------
    // Events Center & Live Registrations
    // -------------------------------------------------------------------------
    match /community_events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;

      allow create: if isVerifiedUser()
        && isValidId(eventId)
        && incoming().keys().hasAll(['organizerUid', 'organizerName', 'organizerOrg', 'eventType', 'title', 'description', 'dateIso', 'venueOrLink', 'capacity', 'attendeesCount', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['organizerUid', 'organizerName', 'organizerOrg', 'companyId', 'eventType', 'title', 'description', 'speakers', 'dateIso', 'venueOrLink', 'capacity', 'attendeesCount', 'academyCourseId', 'postEventResources', 'status', 'createdAt', 'updatedAt'])
        && incoming().organizerUid == request.auth.uid
        && incoming().eventType in ['conference', 'webinar', 'workshop', 'seminar', 'training', 'career_fair', 'networking']
        && incoming().title is string && incoming().title.size() >= 3 && incoming().title.size() <= 180
        && incoming().description is string && incoming().description.size() >= 5 && incoming().description.size() <= 2000
        && incoming().capacity is number && incoming().capacity >= 1 && incoming().capacity <= 50000
        && incoming().attendeesCount == 0
        && incoming().status in ['upcoming', 'completed', 'cancelled']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(eventId)
        && incoming().organizerUid == existing().organizerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || existing().organizerUid == request.auth.uid
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['attendeesCount', 'updatedAt'])
            && (incoming().attendeesCount == existing().attendeesCount + 1 || incoming().attendeesCount == existing().attendeesCount - 1)
          )
        );

      allow delete: if isValidId(eventId) && (isAdmin() || (isVerifiedUser() && existing().organizerUid == request.auth.uid));

      match /registrations/{userId} {
        allow get: if isValidId(eventId) && isValidId(userId) && (isOwner(userId) || isAdmin() || get(/databases/$(database)/documents/community_events/$(eventId)).data.organizerUid == request.auth.uid);
        allow list: if isVerifiedUser();
        allow create, update: if isVerifiedUser()
          && isValidId(eventId)
          && isOwner(userId)
          && incoming().keys().hasAll(['eventId', 'uid', 'displayName', 'status', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['eventId', 'uid', 'displayName', 'status', 'createdAt', 'updatedAt'])
          && incoming().eventId == eventId
          && incoming().uid == request.auth.uid
          && incoming().status in ['registered', 'cancelled']
          && incoming().updatedAt == request.time;
        allow delete: if isVerifiedUser() && (isOwner(userId) || isAdmin());
      }
    }

    // -------------------------------------------------------------------------
    // Follows (Member / Company), Bookmarks & Job Applications
    // -------------------------------------------------------------------------
    match /community_follows/{followId} {
      allow get: if isVerifiedUser() && isValidId(followId);
      allow list: if isAdminEmail() || (isVerifiedUser() && (existing().followerUid == request.auth.uid || existing().targetId == request.auth.uid));
      allow create: if isVerifiedUser()
        && isValidId(followId)
        && incoming().keys().hasAll(['followerUid', 'targetType', 'targetId', 'targetName', 'createdAt'])
        && incoming().keys().hasOnly(['followerUid', 'targetType', 'targetId', 'targetName', 'createdAt'])
        && incoming().followerUid == request.auth.uid
        && incoming().targetType in ['member', 'company']
        && isValidId(incoming().targetId)
        && followId == (request.auth.uid + '_' + incoming().targetType + '_' + incoming().targetId)
        && incoming().targetName is string && incoming().targetName.size() <= 160
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && (existing().followerUid == request.auth.uid || isAdmin());
    }

    match /community_bookmarks/{bookmarkId} {
      allow get: if isVerifiedUser() && existing().uid == request.auth.uid;
      allow list: if isVerifiedUser() && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(bookmarkId)
        && incoming().keys().hasAll(['uid', 'postId', 'postTitle', 'createdAt'])
        && incoming().keys().hasOnly(['uid', 'postId', 'postTitle', 'createdAt'])
        && incoming().uid == request.auth.uid
        && isValidId(incoming().postId)
        && bookmarkId == (request.auth.uid + '_' + incoming().postId)
        && incoming().postTitle is string && incoming().postTitle.size() <= 180
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
    }

    match /community_job_applications/{applicationId} {
      allow get: if isVerifiedUser() && isValidId(applicationId)
        && (isAdmin() || existing().applicantUid == request.auth.uid || existing().employerUid == request.auth.uid);
      allow list: if isAdminEmail()
        || (isVerifiedUser() && (existing().applicantUid == request.auth.uid || existing().employerUid == request.auth.uid));

      allow create: if isVerifiedUser()
        && isValidId(applicationId)
        && incoming().keys().hasAll(['opportunityId', 'opportunityTitle', 'employerUid', 'applicantUid', 'applicantName', 'coverNote', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['opportunityId', 'opportunityTitle', 'employerUid', 'applicantUid', 'applicantName', 'applicantHeadline', 'applicantOrg', 'coverNote', 'cvSummary', 'status', 'createdAt', 'updatedAt'])
        && isValidId(incoming().opportunityId)
        && isValidId(incoming().employerUid)
        && incoming().applicantUid == request.auth.uid
        && incoming().employerUid != request.auth.uid
        && applicationId == (incoming().opportunityId + '_' + request.auth.uid)
        && incoming().status == 'submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(applicationId)
        && incoming().opportunityId == existing().opportunityId
        && incoming().applicantUid == existing().applicantUid
        && incoming().employerUid == existing().employerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().employerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status in ['submitted', 'shortlisted', 'contacted', 'rejected']
          )
        );

      allow delete: if isVerifiedUser() && (isAdmin() || existing().applicantUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Private Direct Messaging & Blocking
    // -------------------------------------------------------------------------
    match /community_message_threads/{threadId} {
      allow get: if isVerifiedUser() && isValidId(threadId) && (request.auth.uid in existing().participantUids || isAdmin());
      allow list: if isAdminEmail() || (isVerifiedUser() && request.auth.uid in existing().participantUids);

      allow create: if isVerifiedUser()
        && isValidId(threadId)
        && incoming().keys().hasAll(['participantUids', 'participantNames', 'lastMessage', 'lastSenderUid', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['participantUids', 'participantNames', 'lastMessage', 'lastSenderUid', 'createdAt', 'updatedAt'])
        && incoming().participantUids is list && incoming().participantUids.size() == 2
        && request.auth.uid in incoming().participantUids
        && incoming().lastSenderUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(threadId)
        && request.auth.uid in existing().participantUids
        && incoming().participantUids == existing().participantUids
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      match /messages/{messageId} {
        allow get: if isVerifiedUser() && isValidId(threadId) && isValidId(messageId)
          && request.auth.uid in get(/databases/$(database)/documents/community_message_threads/$(threadId)).data.participantUids;
        allow list: if isVerifiedUser() && isValidId(threadId)
          && request.auth.uid in get(/databases/$(database)/documents/community_message_threads/$(threadId)).data.participantUids;

        allow create: if isVerifiedUser()
          && isValidId(threadId)
          && isValidId(messageId)
          && request.auth.uid in get(/databases/$(database)/documents/community_message_threads/$(threadId)).data.participantUids
          && incoming().keys().hasAll(['threadId', 'senderUid', 'senderName', 'recipientUid', 'body', 'isRead', 'createdAt'])
          && incoming().keys().hasOnly(['threadId', 'senderUid', 'senderName', 'recipientUid', 'body', 'attachmentUrl', 'isRead', 'createdAt'])
          && incoming().threadId == threadId
          && incoming().senderUid == request.auth.uid
          && incoming().recipientUid != request.auth.uid
          && incoming().recipientUid in get(/databases/$(database)/documents/community_message_threads/$(threadId)).data.participantUids
          && !exists(/databases/$(database)/documents/community_blocks/$(incoming().recipientUid + '_' + request.auth.uid))
          && incoming().body is string && incoming().body.size() >= 1 && incoming().body.size() <= 2000
          && (!('attachmentUrl' in incoming()) || (incoming().attachmentUrl is string && incoming().attachmentUrl.matches('https://.*') && incoming().attachmentUrl.size() <= 500))
          && incoming().isRead == false
          && incoming().createdAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(threadId)
          && isValidId(messageId)
          && existing().recipientUid == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          && incoming().isRead == true;
      }
    }

    match /community_blocks/{blockId} {
      allow get: if isVerifiedUser() && existing().blockerUid == request.auth.uid;
      allow list: if isVerifiedUser() && existing().blockerUid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(blockId)
        && incoming().keys().hasAll(['blockerUid', 'blockedUid', 'createdAt'])
        && incoming().keys().hasOnly(['blockerUid', 'blockedUid', 'reason', 'createdAt'])
        && incoming().blockerUid == request.auth.uid
        && isValidId(incoming().blockedUid)
        && incoming().blockedUid != request.auth.uid
        && blockId == (request.auth.uid + '_' + incoming().blockedUid)
        && incoming().createdAt == request.time;
      allow delete: if isVerifiedUser() && existing().blockerUid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Internal Platform Engineering Email (/community_emails/{emailId})
    // -------------------------------------------------------------------------
    function isValidCommunityEmail(data) {
      return data.keys().hasAll([
          'participantUids', 'senderUid', 'senderName', 'recipientUid', 'recipientName',
          'subject', 'category', 'priority', 'body',
          'recipientRead', 'senderStarred', 'recipientStarred',
          'senderFolder', 'recipientFolder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'participantUids', 'senderUid', 'senderName', 'senderOrg',
          'recipientUid', 'recipientName',
          'subject', 'category', 'priority', 'body', 'attachmentUrl', 'replyToEmailId',
          'recipientRead', 'senderStarred', 'recipientStarred',
          'senderFolder', 'recipientFolder', 'createdAt', 'updatedAt'
        ])
        && data.participantUids is list
        && data.participantUids.size() == 2
        && isValidId(data.senderUid)
        && isValidId(data.recipientUid)
        && data.senderUid != data.recipientUid
        && data.senderUid in data.participantUids
        && data.recipientUid in data.participantUids
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120
        && (!('senderOrg' in data) || (data.senderOrg is string && data.senderOrg.size() <= 160))
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 120
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 180
        && data.category in ['general', 'technical_inquiry', 'inspection_coordination', 'job_inquiry', 'academy']
        && data.priority in ['normal', 'urgent']
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 5000
        && (!('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.matches('https://.*') && data.attachmentUrl.size() <= 500))
        && (!('replyToEmailId' in data) || isValidId(data.replyToEmailId))
        && data.recipientRead is bool
        && data.senderStarred is bool
        && data.recipientStarred is bool
        && data.senderFolder in ['sent', 'archive']
        && data.recipientFolder in ['inbox', 'archive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /community_emails/{emailId} {
      allow get: if isVerifiedUser() && isValidId(emailId)
        && (request.auth.uid in existing().participantUids || isAdmin());
      allow list: if isAdminEmail()
        || (isVerifiedUser() && request.auth.uid in existing().participantUids);

      allow create: if isVerifiedUser()
        && isValidId(emailId)
        && isValidCommunityEmail(incoming())
        && incoming().senderUid == request.auth.uid
        && !exists(/databases/$(database)/documents/community_blocks/$(incoming().recipientUid + '_' + request.auth.uid))
        && incoming().recipientRead == false
        && incoming().senderStarred == false
        && incoming().recipientStarred == false
        && incoming().senderFolder == 'sent'
        && incoming().recipientFolder == 'inbox'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(emailId)
        && isValidCommunityEmail(incoming())
        && incoming().participantUids == existing().participantUids
        && incoming().senderUid == existing().senderUid
        && incoming().recipientUid == existing().recipientUid
        && incoming().subject == existing().subject
        && incoming().category == existing().category
        && incoming().priority == existing().priority
        && incoming().body == existing().body
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().senderUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['senderStarred', 'senderFolder', 'updatedAt'])
          )
          || (
            existing().recipientUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['recipientRead', 'recipientStarred', 'recipientFolder', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(emailId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Notifications & Preferences
    // -------------------------------------------------------------------------
    match /community_notifications/{notificationId} {
      allow get: if isVerifiedUser() && isValidId(notificationId) && (existing().recipientUid == request.auth.uid || isAdmin());
      allow list: if isAdminEmail() || (isVerifiedUser() && existing().recipientUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(notificationId)
        && incoming().keys().hasAll(['recipientUid', 'actorUid', 'actorName', 'category', 'title', 'body', 'isRead', 'createdAt'])
        && incoming().keys().hasOnly(['recipientUid', 'actorUid', 'actorName', 'category', 'title', 'body', 'linkSection', 'linkEntryId', 'isRead', 'createdAt'])
        && isValidId(incoming().recipientUid)
        && incoming().actorUid == request.auth.uid
        && incoming().category in ['connection', 'comment', 'reaction', 'group', 'job', 'message', 'academy', 'verification', 'event']
        && incoming().isRead == false
        && incoming().createdAt == request.time;

      allow update: if isVerifiedUser()
        && (existing().recipientUid == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
        && incoming().isRead is bool;

      allow delete: if isVerifiedUser() && (existing().recipientUid == request.auth.uid || isAdmin());
    }

    match /community_notification_prefs/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create, update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['connections', 'comments', 'groups', 'jobs', 'messages', 'events', 'academy', 'weeklyDigest', 'updatedAt'])
        && incoming().keys().hasOnly(['connections', 'comments', 'groups', 'jobs', 'messages', 'events', 'academy', 'weeklyDigest', 'updatedAt'])
        && incoming().connections is bool
        && incoming().comments is bool
        && incoming().groups is bool
        && incoming().jobs is bool
        && incoming().messages is bool
        && incoming().events is bool
        && incoming().academy is bool
        && incoming().weeklyDigest is bool
        && incoming().updatedAt == request.time;
    }

    // -------------------------------------------------------------------------
    // Three-Track Verification Queue & Moderation Reports (Admin Audited)
    // -------------------------------------------------------------------------
    match /community_verifications/{verificationId} {
      allow get: if isVerifiedUser() && isValidId(verificationId) && (isAdmin() || existing().uid == request.auth.uid);
      allow list: if isAdminEmail() || (isVerifiedUser() && existing().uid == request.auth.uid);

      // Default state is ALWAYS pending; non-admin cannot self-approve or pick reviewer fields.
      allow create: if isVerifiedUser()
        && isValidId(verificationId)
        && incoming().keys().hasAll(['uid', 'memberName', 'track', 'subjectTitle', 'issuerOrCompany', 'evidenceNote', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'memberName', 'track', 'subjectTitle', 'issuerOrCompany', 'evidenceNote', 'evidenceUrl', 'companyId', 'status', 'createdAt', 'updatedAt'])
        && incoming().uid == request.auth.uid
        && incoming().track in ['identity', 'organization', 'credential']
        && incoming().status == 'pending'
        && (!('evidenceUrl' in incoming()) || (incoming().evidenceUrl is string && incoming().evidenceUrl.matches('https://.*') && incoming().evidenceUrl.size() <= 500))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(verificationId)
        && incoming().uid == existing().uid
        && incoming().track == existing().track
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().status in ['pending', 'approved', 'rejected'];

      allow delete: if isVerifiedUser() && (isAdmin() || (existing().uid == request.auth.uid && existing().status == 'pending'));
    }

    match /community_reports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && (isAdmin() || existing().reporterUid == request.auth.uid);
      allow list: if isAdminEmail() || (isVerifiedUser() && existing().reporterUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && incoming().keys().hasAll(['reporterUid', 'reporterName', 'targetType', 'targetId', 'targetTitle', 'reason', 'status', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['reporterUid', 'reporterName', 'targetType', 'targetId', 'targetTitle', 'reason', 'status', 'createdAt', 'updatedAt'])
        && incoming().reporterUid == request.auth.uid
        && incoming().targetType in ['post', 'comment', 'answer', 'company', 'job', 'user', 'message']
        && incoming().status == 'open'
        && incoming().reason is string && incoming().reason.size() >= 4 && incoming().reason.size() <= 800
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(reportId)
        && incoming().reporterUid == existing().reporterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().status in ['open', 'reviewed', 'dismissed', 'action_taken'];
    }

    // -------------------------------------------------------------------------
    // Client Requests Intake
    // -------------------------------------------------------------------------
    match /client_requests/{requestId} {
      allow get: if isValidId(requestId)
        && (isAdmin() || (isVerifiedUser() && existing().submittedByUid == request.auth.uid));
      allow list: if isAdminEmail()
        || (isVerifiedUser() && existing().submittedByUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidClientRequest(incoming())
        && incoming().submittedByUid == request.auth.uid
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !('adminNotes' in incoming());

      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidClientRequest(incoming())
        && incoming().submittedByUid == existing().submittedByUid
        && incoming().requestCode == existing().requestCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'adminNotes', 'companyCode', 'updatedAt'
          ]))
          || (
            existing().submittedByUid == request.auth.uid
            && existing().status == 'new'
            && incoming().status == 'new'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'companyName', 'companyCode', 'contactName', 'phone',
              'serviceMethods', 'projectLocation', 'urgency', 'scopeSummary', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(requestId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Unique Company Code Reservation Index
    // -------------------------------------------------------------------------
    match /company_codes/{companyCode} {
      allow get: if isValidCode(companyCode) && (isAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid));
      allow list: if isAdminEmail() || (isVerifiedUser() && existing().createdByUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidCompanyCodeReservation(incoming(), companyCode)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/companies/$(incoming().companyId));
      allow update: if false;
      allow delete: if isValidCode(companyCode) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Companies Archive & Self-Service Business Workspaces
    // -------------------------------------------------------------------------
    match /companies/{companyId} {
      allow get: if isValidId(companyId)
        && (isAdmin() || (isVerifiedUser() && existing().assignedClientUid != '' && existing().assignedClientUid == request.auth.uid));
      allow list: if isAdminEmail()
        || (isVerifiedUser() && existing().assignedClientUid != '' && existing().assignedClientUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(companyId)
        && isValidCompanyRecord(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().reportsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/company_codes/$(incoming().companyCode))
        && (isAdmin() || incoming().assignedClientUid == request.auth.uid);

      allow update: if isVerifiedUser()
        && isValidId(companyId)
        && isValidCompanyRecord(incoming())
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().companyCode == existing().companyCode
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'nameAr', 'nameEn', 'archiveCategory', 'hasActiveTestingDossier',
            'sector', 'commercialRegNo', 'contactPerson', 'contactEmail',
            'contactPhone', 'projectLocation', 'activeScope',
            'assignedClientUid', 'legacySinceYear', 'reportsCount',
            'siteLat', 'siteLng', 'geofenceRadiusMeters', 'updatedAt'
          ]))
          || (
            existing().assignedClientUid == request.auth.uid
            && incoming().assignedClientUid == existing().assignedClientUid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'nameAr', 'nameEn', 'archiveCategory', 'hasActiveTestingDossier',
              'sector', 'commercialRegNo', 'contactPerson', 'contactEmail',
              'contactPhone', 'projectLocation', 'activeScope',
              'legacySinceYear', 'reportsCount',
              'siteLat', 'siteLng', 'geofenceRadiusMeters', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(companyId) && isAdmin();

      // -----------------------------------------------------------------------
      // Dedicated Company File / Dossier: Inspection Reports Subcollection
      // Master Gate: enforces parent company existence & owner/client alignment
      // -----------------------------------------------------------------------
      match /reports/{reportId} {
        allow get: if isValidId(companyId) && isValidId(reportId) && (
          isAdmin()
          || (
            isVerifiedUser()
            && get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid != ''
            && get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid == request.auth.uid
          )
        );
        allow list: if isAdminEmail()
          || (isVerifiedUser() && existing().assignedClientUid != '' && existing().assignedClientUid == request.auth.uid);

        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(reportId)
          && isValidInspectionReport(incoming(), companyId)
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && incoming().companyCode == get(/databases/$(database)/documents/companies/$(companyId)).data.companyCode
          && incoming().assignedClientUid == get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid
          && (
            isAdmin()
            || get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid == request.auth.uid
          );

        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(reportId)
          && isValidInspectionReport(incoming(), companyId)
          && incoming().companyId == existing().companyId
          && incoming().companyCode == existing().companyCode
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              existing().assignedClientUid == request.auth.uid
              && existing().status != 'archived'
              && incoming().assignedClientUid == existing().assignedClientUid
            )
          )
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'assignedClientUid', 'reportNumber', 'templateKey', 'method',
            'isLegacyArchive', 'projectName', 'clientPoNumber',
            'componentOrJointId', 'materialSpec', 'thicknessMm',
            'codeStandard', 'inspectorName', 'inspectionDate',
            'verdict', 'status', 'technicalData', 'notes', 'updatedAt'
          ]);

        allow delete: if isValidId(companyId) && isValidId(reportId)
          && (isAdmin() || (isVerifiedUser() && existing().assignedClientUid == request.auth.uid));
      }

      // -----------------------------------------------------------------------
      // Field Technicians / Employees Subcollection
      // -----------------------------------------------------------------------
      match /employees/{employeeId} {
        allow get: if isValidId(companyId) && isValidId(employeeId) && (
          isAdmin()
          || (isVerifiedUser() && (
            existing().ownerUid == request.auth.uid
            || (existing().workerUid != '' && existing().workerUid == request.auth.uid)
          ))
        );
        allow list: if isAdminEmail()
          || (isVerifiedUser() && (
            existing().ownerUid == request.auth.uid
            || (existing().workerUid != '' && existing().workerUid == request.auth.uid)
          ));

        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(employeeId)
          && isValidCompanyEmployee(incoming(), companyId)
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && incoming().companyCode == get(/databases/$(database)/documents/companies/$(companyId)).data.companyCode
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid == request.auth.uid
              && incoming().ownerUid == request.auth.uid
            )
          );

        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(employeeId)
          && isValidCompanyEmployee(incoming(), companyId)
          && incoming().companyId == existing().companyId
          && incoming().companyCode == existing().companyCode
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || existing().ownerUid == request.auth.uid
            || (
              existing().workerUid != ''
              && existing().workerUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'lastLat', 'lastLng', 'lastSeenAt', 'onlineStatus',
                'faceEnrolled', 'faceDigest', 'updatedAt'
              ])
            )
          );

        allow delete: if isValidId(companyId) && isValidId(employeeId)
          && (isAdmin() || (isVerifiedUser() && existing().ownerUid == request.auth.uid));
      }

      // -----------------------------------------------------------------------
      // Immutable Geofenced Attendance Check-In / Check-Out Timeline Logs
      // -----------------------------------------------------------------------
      match /attendance/{logId} {
        allow get: if isValidId(companyId) && isValidId(logId) && (
          isAdmin()
          || (isVerifiedUser() && (
            existing().ownerUid == request.auth.uid
            || existing().workerUid == request.auth.uid
          ))
        );
        allow list: if isAdminEmail()
          || (isVerifiedUser() && (
            existing().ownerUid == request.auth.uid
            || existing().workerUid == request.auth.uid
          ));

        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(logId)
          && isValidAttendanceLog(incoming(), companyId)
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && incoming().companyCode == get(/databases/$(database)/documents/companies/$(companyId)).data.companyCode
          && incoming().workerUid == request.auth.uid
          && incoming().createdAt == request.time
          && (
            isAdmin()
            || get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid == request.auth.uid
            || incoming().ownerUid == request.auth.uid
          );

        allow update: if false;
        allow delete: if isValidId(companyId) && isValidId(logId) && isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // Existing Academy & Diagnostics Paths
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
    }

    match /user_module_progress/{progressId} {
      allow get: if isValidId(progressId) && isVerifiedUser()
        && (existing().userId == request.auth.uid || (isAccountReviewer() && hasAccountReview(existing().userId)));
      allow list: if isVerifiedUser() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(progressId)
        && isValidModuleProgress(incoming()) && incoming().userId == request.auth.uid
        && progressId == (incoming().userId + '_' + incoming().moduleId);
      allow update: if isVerifiedUser() && isValidId(progressId)
        && isValidModuleProgress(incoming()) && existing().userId == request.auth.uid
        && incoming().userId == existing().userId && incoming().moduleId == existing().moduleId;
      allow delete: if isVerifiedUser() && isValidId(progressId) && existing().userId == request.auth.uid;
    }

    match /quiz_leaderboard/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidQuizLeaderboardEntry(incoming());
    }
  }
}
