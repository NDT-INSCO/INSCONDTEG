    "/community_workspaces/{userId}": {
      "schema": { "$ref": "#/entities/CommunityWorkspaceProfile" },
      "description": "Opt-in LinkedIn-style engineering & business community profiles without PII (email/phone excluded)"
    },
    "/community_posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Public/members INSCO Community technical posts, discussions, and pinned announcements (zero PII)"
    },
    "/community_posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/CommunityPostComment" },
      "description": "Threaded replies on INSCO Community posts"
    },
    "/community_posts/{postId}/reactions/{userId}": {
      "schema": { "$ref": "#/entities/CommunityPostReaction" },
      "description": "User reactions per community post keyed by uid"
    },
    "/community_connections/{connectionId}": {
      "schema": { "$ref": "#/entities/CommunityConnection" },
      "description": "Professional network connections between INSCO Community members"
    },
    "/community_opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/CommunityOpportunity" },
      "description": "NDT careers, tenders, and equipment opportunities board (zero PII)"
    },
    "/community_companies/{companyId}": {
      "schema": { "$ref": "#/entities/CommunityCompany" },
      "description": "Public engineering company pages with organization verification state"
    },
    "/community_companies/{companyId}/departments/{deptId}": {
      "schema": { "$ref": "#/entities/CommunityCompanyDepartment" },
      "description": "Interactive organizational chart nodes & department mini-pages"
    },
    "/community_companies/{companyId}/affiliations/{affiliationId}": {
      "schema": { "$ref": "#/entities/CommunityCompanyAffiliation" },
      "description": "Explicit employee affiliation requests & consent records"
    },
    "/community_events/{eventId}": {
      "schema": { "$ref": "#/entities/CommunityEvent" },
      "description": "Community workshops, webinars, conferences, and networking events"
    },
    "/community_verifications/{verificationId}": {
      "schema": { "$ref": "#/entities/CommunityVerification" },
      "description": "Three-track manual verification requests (identity, organization, credential)"
    },
    "/community_emails/{emailId}": {
      "schema": { "$ref": "#/entities/CommunityEmail" },
      "description": "Internal platform emails exchanged between verified community members"
    }
  }
