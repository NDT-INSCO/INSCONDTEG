# AI tutor configuration
#
# The key is read by `server.ts` only. It is never bundled into the browser:
# the static GitHub Pages build ships no key and no AI code, and the browser
# talks to `/api/ai/*` (or to `VITE_AI_BASE_URL` when the gateway lives on
# another host, e.g. Cloud Run).
GEMINI_API_KEY=

# Where the browser should send tutor requests, when the gateway is not on the
# same origin as the page. Leave empty for same-origin (`/api/ai/*`).
# Example: https://insco-tutor-xxxx.a.run.app
VITE_AI_BASE_URL=

# Server port
PORT=3000

# Which Google interface to call.
#   auto         — Interactions API first, legacy models API only if the
#                  endpoint is unavailable (default)
#   interactions — Interactions API only (fails loudly if the key cannot use it)
#   legacy       — old models.generateContentStream path only
TUTOR_API_MODE=auto

# Optional model override for the answer. The default and its fallbacks live in
# src/ai/contract.ts (`TUTOR_MODELS`), so this only needs setting to pin a model.
TUTOR_MODEL=

# Rate limits and budget (per IP unless noted)
TUTOR_RATE_PER_MINUTE=10
TUTOR_RATE_PER_DAY=200
# Hard daily cap across all IPs, a cost guard for the API key.
TUTOR_DAILY_LIMIT=300
TUTOR_TIMEOUT_MS=45000

# ── RFQ (طلب عرض سعر) ─────────────────────────────────────────────────────
# The browser posts the form to `VITE_RFQ_ENDPOINT` (or to same-origin
# `/api/rfq` when empty). A request is only reported as received after the
# server hands it to one of the channels below. With none configured the
# gateway answers 503 and the page offers email/WhatsApp instead.

# Browser side: gateway base (→ /api/rfq) or a full endpoint (Apps Script /exec)
VITE_RFQ_ENDPOINT=

# Server side, channel 1 (recommended, free): any JSON sink that also sends
# mail — a Google Apps Script web app, Slack webhook, Make/Zapier, etc.
RFQ_WEBHOOK_URL=

# Server side, channel 2: transactional email via Resend.
RESEND_API_KEY=
RFQ_INBOX=
RFQ_FROM=INSCO Website <onboarding@resend.dev>

# ── Private admin workspace ─────────────────────────────────────────────
# Server only. Use a unique password of 8–128 characters, ideally generated.
# Do not use a VITE_ prefix for any secret: VITE_ variables are public.
ADMIN_PASSWORD=
# Optional legacy sign-in (8–32 digits); ignored when ADMIN_PASSWORD is set.
# Leave both empty to disable the portal.
ADMIN_PIN=
# Required in production: the exact HTTPS origin where staff open the portal.
# Leave blank for local development via http://localhost:3000.
ADMIN_ORIGIN=
# Private persistent storage. Default: .admin-data/ next to server.ts.
# Use a mounted volume in production, never docs/, dist/ or public/.
ADMIN_DATA_DIR=
# Optional trusted proxy IP/subnet(s), e.g. loopback for a same-host reverse proxy.
TRUST_PROXY=
# Only when the public site is on a separate host: its exact origin (no subpath).
# Enables cross-origin access to the public RFQ and announcement only.
PUBLIC_SITE_ORIGIN=
# Public Pages build only, e.g. https://admin.example.com/. Never include a password.
# Leave blank for same-origin hosting.
VITE_ADMIN_PORTAL_URL=
