rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true
        || (
          request.auth.token.firebase.sign_in_provider == 'phone'
          && request.auth.token.phone_number is string
          && request.auth.token.phone_number.size() >= 5
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCode(code) {
      return code is string && code.size() >= 3 && code.size() <= 32 && code.matches('^[A-Z0-9\\-]+$');
    }

    // Zero-lookup admin check (strictly requires verified email, never phone auth)
    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'inscondtco@gmail.com';
    }

    // Full admin check (used on single-document reads and writes)
    function isAdmin() {
      return isAdminEmail()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidClientAccount(data, userId) {
      return data.keys().hasAll([
          'uid', 'fullName', 'email', 'phone', 'organizationName',
          'role', 'approvalStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'email', 'phone', 'organizationName',
          'requestedCompanyCode', 'assignedCompanyId', 'assignedCompanyCode',
          'role', 'approvalStatus', 'sector',
          'authMethod', 'jobTitle', 'nationalId', 'secondaryPhone',
          'personalAddress', 'organizationNameEn', 'commercialRegNo',
          'taxCardNo', 'companyPhone', 'companyEmail', 'website',
          'companyAddress', 'cityGovernorate', 'activeScope',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.phone is string && (data.phone == '' || (data.phone.size() >= 5 && data.phone.size() <= 40))
        && data.organizationName is string && (data.organizationName == '' || (data.organizationName.size() >= 2 && data.organizationName.size() <= 160))
        && (!('requestedCompanyCode' in data) || (data.requestedCompanyCode is string && data.requestedCompanyCode.size() <= 32 && data.requestedCompanyCode.matches('^[A-Z0-9\\-]*$')))
        && (!('assignedCompanyId' in data) || (data.assignedCompanyId is string && data.assignedCompanyId.size() <= 128))
        && (!('assignedCompanyCode' in data) || (data.assignedCompanyCode is string && data.assignedCompanyCode.size() <= 32))
        && (!('sector' in data) || (data.sector is string && data.sector.size() <= 80))
        && (!('authMethod' in data) || data.authMethod in ['google', 'email', 'phone'])
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 120))
        && (!('nationalId' in data) || (data.nationalId is string && data.nationalId.size() <= 40))
        && (!('secondaryPhone' in data) || (data.secondaryPhone is string && data.secondaryPhone.size() <= 40))
        && (!('personalAddress' in data) || (data.personalAddress is string && data.personalAddress.size() <= 240))
        && (!('organizationNameEn' in data) || (data.organizationNameEn is string && data.organizationNameEn.size() <= 180))
        && (!('commercialRegNo' in data) || (data.commercialRegNo is string && data.commercialRegNo.size() <= 64))
        && (!('taxCardNo' in data) || (data.taxCardNo is string && data.taxCardNo.size() <= 64))
        && (!('companyPhone' in data) || (data.companyPhone is string && data.companyPhone.size() <= 40))
        && (!('companyEmail' in data) || (data.companyEmail is string && data.companyEmail.size() <= 160))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && (!('companyAddress' in data) || (data.companyAddress is string && data.companyAddress.size() <= 240))
        && (!('cityGovernorate' in data) || (data.cityGovernorate is string && data.cityGovernorate.size() <= 100))
        && (!('activeScope' in data) || (data.activeScope is string && data.activeScope.size() <= 1000))
        && data.role in ['client', 'engineer', 'admin']
        && data.approvalStatus in ['pending', 'approved', 'suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClientRequest(data) {
      return data.keys().hasAll([
          'requestCode', 'submittedByUid', 'submittedByEmail', 'companyName',
          'contactName', 'phone', 'serviceMethods', 'projectLocation',
          'urgency', 'scopeSummary', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestCode', 'submittedByUid', 'submittedByEmail', 'companyName',
          'companyCode', 'contactName', 'phone', 'serviceMethods',
          'projectLocation', 'urgency', 'scopeSummary', 'status',
          'adminNotes', 'createdAt', 'updatedAt'
        ])
        && isValidCode(data.requestCode)
        && isValidId(data.submittedByUid)
        && data.submittedByEmail is string && data.submittedByEmail.size() >= 3 && data.submittedByEmail.size() <= 160
        && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 160
        && (!('companyCode' in data) || (data.companyCode is string && data.companyCode.size() <= 32 && data.companyCode.matches('^[A-Z0-9\\-]*$')))
        && data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 120
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && data.serviceMethods is list && data.serviceMethods.size() >= 1 && data.serviceMethods.size() <= 12
        && data.serviceMethods[0] is string && data.serviceMethods[0].size() <= 32
        && data.projectLocation is string && data.projectLocation.size() >= 2 && data.projectLocation.size() <= 180
        && data.urgency in ['standard', 'priority', 'emergency_24h']
        && data.scopeSummary is string && data.scopeSummary.size() >= 5 && data.scopeSummary.size() <= 2000
        && data.status in ['new', 'under_review', 'approved', 'in_progress', 'completed', 'rejected']
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompanyRecord(data) {
      return data.keys().hasAll([
          'companyCode', 'nameAr', 'nameEn', 'archiveCategory',
          'hasActiveTestingDossier', 'sector', 'assignedClientUid',
          'reportsCount', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'companyCode', 'nameAr', 'nameEn', 'archiveCategory',
          'hasActiveTestingDossier', 'sector', 'commercialRegNo',
          'contactPerson', 'contactEmail', 'contactPhone',
          'projectLocation', 'activeScope', 'assignedClientUid',
          'legacySinceYear', 'reportsCount', 'siteLat', 'siteLng',
          'geofenceRadiusMeters', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && isValidCode(data.companyCode)
        && data.nameAr is string && data.nameAr.size() >= 2 && data.nameAr.size() <= 180
        && data.nameEn is string && data.nameEn.size() >= 2 && data.nameEn.size() <= 180
        && data.archiveCategory in ['active_testing', 'legacy_archive', 'new_onboarding']
        && data.hasActiveTestingDossier is bool
        && data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 100
        && (!('commercialRegNo' in data) || (data.commercialRegNo is string && data.commercialRegNo.size() <= 64))
        && (!('contactPerson' in data) || (data.contactPerson is string && data.contactPerson.size() <= 120))
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 160))
        && (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 40))
        && (!('projectLocation' in data) || (data.projectLocation is string && data.projectLocation.size() <= 180))
        && (!('activeScope' in data) || (data.activeScope is string && data.activeScope.size() <= 1500))
        && data.assignedClientUid is string && data.assignedClientUid.size() <= 128
        && (!('legacySinceYear' in data) || (data.legacySinceYear is string && data.legacySinceYear.size() <= 16))
        && data.reportsCount is number && data.reportsCount >= 0 && data.reportsCount <= 100000
        && (!('siteLat' in data) || (data.siteLat is number && data.siteLat >= -90 && data.siteLat <= 90))
        && (!('siteLng' in data) || (data.siteLng is number && data.siteLng <= 180 && data.siteLng >= -180))
        && (!('geofenceRadiusMeters' in data) || (data.geofenceRadiusMeters is number && data.geofenceRadiusMeters >= 50 && data.geofenceRadiusMeters <= 50000))
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompanyCodeReservation(data, codeId) {
      return data.keys().hasAll(['companyCode', 'companyId', 'createdByUid', 'createdAt'])
        && data.keys().hasOnly(['companyCode', 'companyId', 'createdByUid', 'createdAt'])
        && isValidCode(codeId)
        && data.companyCode == codeId
        && isValidId(data.companyId)
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp;
    }

    function isValidInspectionReport(data, parentCompanyId) {
      return data.keys().hasAll([
          'companyId', 'companyCode', 'assignedClientUid', 'reportNumber',
          'templateKey', 'method', 'isLegacyArchive', 'projectName',
          'componentOrJointId', 'codeStandard', 'inspectorName',
          'inspectionDate', 'verdict', 'status', 'technicalData',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'companyId', 'companyCode', 'assignedClientUid', 'reportNumber',
          'templateKey', 'method', 'isLegacyArchive', 'projectName',
          'clientPoNumber', 'componentOrJointId', 'materialSpec',
          'thicknessMm', 'codeStandard', 'inspectorName', 'inspectionDate',
          'verdict', 'status', 'technicalData', 'notes',
          'createdByUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.companyId) && data.companyId == parentCompanyId
        && isValidCode(data.companyCode)
        && data.assignedClientUid is string && data.assignedClientUid.size() <= 128
        && data.reportNumber is string && data.reportNumber.size() >= 3 && data.reportNumber.size() <= 64 && data.reportNumber.matches('^[A-Z0-9\\-/]+$')
        && data.templateKey is string && data.templateKey.size() >= 2 && data.templateKey.size() <= 64
        && data.method in ['RT', 'UT', 'PAUT', 'MT', 'PT', 'VT', 'PMI', 'PWHT', 'HYDRO', 'CUSTOM']
        && data.isLegacyArchive is bool
        && data.projectName is string && data.projectName.size() >= 2 && data.projectName.size() <= 180
        && (!('clientPoNumber' in data) || (data.clientPoNumber is string && data.clientPoNumber.size() <= 80))
        && data.componentOrJointId is string && data.componentOrJointId.size() >= 1 && data.componentOrJointId.size() <= 160
        && (!('materialSpec' in data) || (data.materialSpec is string && data.materialSpec.size() <= 100))
        && (!('thicknessMm' in data) || (data.thicknessMm is string && data.thicknessMm.size() <= 40))
        && data.codeStandard is string && data.codeStandard.size() >= 2 && data.codeStandard.size() <= 120
        && data.inspectorName is string && data.inspectorName.size() >= 2 && data.inspectorName.size() <= 120
        && data.inspectionDate is string && data.inspectionDate.size() >= 8 && data.inspectionDate.size() <= 20
        && data.verdict in ['ACCEPT', 'REJECT', 'HOLD', 'REVIEW']
        && data.status in ['draft', 'issued', 'archived']
        && data.technicalData is map && data.technicalData.size() <= 30
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompanyEmployee(data, parentCompanyId) {
      return data.keys().hasAll([
          'companyId', 'companyCode', 'ownerUid', 'fullName',
          'roleTitle', 'badgeCode', 'faceEnrolled', 'onlineStatus',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'companyId', 'companyCode', 'ownerUid', 'workerUid', 'fullName',
          'roleTitle', 'badgeCode', 'phone', 'faceEnrolled', 'faceDigest',
          'lastLat', 'lastLng', 'lastSeenAt', 'onlineStatus',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.companyId) && data.companyId == parentCompanyId
        && isValidCode(data.companyCode)
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && (!('workerUid' in data) || (data.workerUid is string && data.workerUid.size() <= 128))
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.roleTitle is string && data.roleTitle.size() >= 2 && data.roleTitle.size() <= 120
        && data.badgeCode is string && data.badgeCode.size() >= 2 && data.badgeCode.size() <= 40 && data.badgeCode.matches('^[A-Z0-9\\-]+$')
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.faceEnrolled is bool
        && (!('faceDigest' in data) || (data.faceDigest is string && data.faceDigest.size() <= 128))
        && (!('lastLat' in data) || (data.lastLat is number && data.lastLat >= -90 && data.lastLat <= 90))
        && (!('lastLng' in data) || (data.lastLng is number && data.lastLng >= -180 && data.lastLng <= 180))
        && (!('lastSeenAt' in data) || (data.lastSeenAt is string && data.lastSeenAt.size() <= 40))
        && data.onlineStatus in ['on_site', 'off_duty', 'in_transit', 'alert']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendanceLog(data, parentCompanyId) {
      return data.keys().hasAll([
          'companyId', 'companyCode', 'ownerUid', 'employeeId',
          'employeeName', 'workerUid', 'eventType', 'lat', 'lng',
          'distanceFromSiteMeters', 'geofenceRadiusMeters', 'geofenceStatus',
          'faceVerified', 'verificationMethod', 'timestampIso', 'createdAt'
        ])
        && data.keys().hasOnly([
          'companyId', 'companyCode', 'ownerUid', 'employeeId',
          'employeeName', 'workerUid', 'eventType', 'lat', 'lng',
          'accuracyMeters', 'distanceFromSiteMeters', 'geofenceRadiusMeters',
          'geofenceStatus', 'faceVerified', 'faceSnapshotHash',
          'verificationMethod', 'deviceLabel', 'notes', 'timestampIso', 'createdAt'
        ])
        && isValidId(data.companyId) && data.companyId == parentCompanyId
        && isValidCode(data.companyCode)
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && isValidId(data.employeeId)
        && data.employeeName is string && data.employeeName.size() >= 2 && data.employeeName.size() <= 120
        && isValidId(data.workerUid)
        && data.eventType in ['check_in', 'check_out']
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('accuracyMeters' in data) || (data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 50000))
        && data.distanceFromSiteMeters is number && data.distanceFromSiteMeters >= 0 && data.distanceFromSiteMeters <= 20000000
        && data.geofenceRadiusMeters is number && data.geofenceRadiusMeters >= 50 && data.geofenceRadiusMeters <= 50000
        && data.geofenceStatus in ['inside_geofence', 'outside_geofence']
        && data.faceVerified is bool
        && (!('faceSnapshotHash' in data) || (data.faceSnapshotHash is string && data.faceSnapshotHash.size() <= 128))
        && data.verificationMethod in ['face_gps', 'gps_only', 'manual_override']
        && (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.timestampIso is string && data.timestampIso.size() >= 10 && data.timestampIso.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidCommunityWorkspace(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'organizationName', 'sector',
          'companiesManaged', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'organizationName', 'sector', 'city',
          'companyCode', 'specialtyTrades', 'bio', 'companiesManaged',
          'isPublished', 'headline', 'certifications', 'yearsExperience',
          'availabilityStatus', 'followersCount', 'endorsementsCount',
          'photoURL', 'bannerURL', 'linkedInUrl', 'profileVisibility',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid) && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120
        && data.organizationName is string && data.organizationName.size() >= 2 && data.organizationName.size() <= 160
        && data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 100
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('companyCode' in data) || (data.companyCode is string && data.companyCode.size() <= 32))
        && (!('specialtyTrades' in data) || (data.specialtyTrades is string && data.specialtyTrades.size() <= 300))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 600))
        && (!('headline' in data) || (data.headline is string && data.headline.size() <= 160))
        && (!('certifications' in data) || (data.certifications is string && data.certifications.size() <= 240))
        && (!('yearsExperience' in data) || (data.yearsExperience is number && data.yearsExperience >= 0 && data.yearsExperience <= 70))
        && (!('availabilityStatus' in data) || data.availabilityStatus in ['active_field', 'open_to_work', 'hiring', 'offering_services'])
        && (!('followersCount' in data) || (data.followersCount is number && data.followersCount >= 0 && data.followersCount <= 1000000))
        && (!('endorsementsCount' in data) || (data.endorsementsCount is number && data.endorsementsCount >= 0 && data.endorsementsCount <= 1000000))
        && data.companiesManaged is number && data.companiesManaged >= 0 && data.companiesManaged <= 10000
        && data.isPublished is bool
        // Photos and the LinkedIn button. HTTPS only: an http:// image would be
        // blocked as mixed content on the HTTPS site, and the LinkedIn check keeps
        // that button from becoming a redirect to anywhere else.
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.matches('https://.*') && data.photoURL.size() <= 500))
        && (!('bannerURL' in data) || (data.bannerURL is string && data.bannerURL.matches('https://.*') && data.bannerURL.size() <= 500))
        && (!('linkedInUrl' in data) || (
          data.linkedInUrl is string
          && data.linkedInUrl.matches('https://([a-z0-9-]+[.])*(linkedin[.]com|lnkd[.]in)/.*')
          && data.linkedInUrl.size() <= 500
        ))
        // Absence means public: every card written before this field existed keeps
        // working, and no member is silently hidden by an upgrade.
        && (!('profileVisibility' in data) || data.profileVisibility in ['public', 'members'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'authorOrg', 'postType', 'ndtMethod',
          'title', 'body', 'likesCount', 'commentsCount', 'visibility',
          'aiModerationStatus', 'isPinnedAnnouncement', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorUid', 'authorName', 'authorHeadline', 'authorOrg', 'authorCompanyCode',
          'postType', 'ndtMethod', 'title', 'body', 'tags', 'technicalSnippet',
          'aiSummary', 'likesCount', 'commentsCount', 'visibility',
          'aiModerationStatus', 'isPinnedAnnouncement', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && (!('authorHeadline' in data) || (data.authorHeadline is string && data.authorHeadline.size() <= 160))
        && data.authorOrg is string && data.authorOrg.size() >= 2 && data.authorOrg.size() <= 160
        && (!('authorCompanyCode' in data) || (data.authorCompanyCode is string && data.authorCompanyCode.size() <= 32))
        && data.postType in ['technical_case', 'job_tender', 'discussion', 'equipment_review', 'announcement']
        && data.ndtMethod in ['GENERAL', 'RT', 'UT', 'PAUT', 'MT', 'PT', 'VT', 'PWHT', 'AR']
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 180
        && data.body is string && data.body.size() >= 5 && data.body.size() <= 3000
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 6 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 32))))
        && (!('technicalSnippet' in data) || (data.technicalSnippet is string && data.technicalSnippet.size() <= 600))
        && (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 800))
        && data.likesCount is number && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.commentsCount is number && data.commentsCount >= 0 && data.commentsCount <= 1000000
        && data.visibility in ['public', 'members_only']
        && data.aiModerationStatus in ['approved', 'flagged']
        && data.isPinnedAnnouncement is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityComment(data, parentPostId) {
      return data.keys().hasAll([
          'postId', 'authorUid', 'authorName', 'body', 'isAiAssisted', 'createdAt'
        ])
        && data.keys().hasOnly([
          'postId', 'authorUid', 'authorName', 'authorHeadline',
          'body', 'isAiAssisted', 'createdAt'
        ])
        && isValidId(data.postId) && data.postId == parentPostId
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && (!('authorHeadline' in data) || (data.authorHeadline is string && data.authorHeadline.size() <= 160))
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 1500
        && data.isAiAssisted is bool
        && data.createdAt is timestamp;
    }

    function isValidCommunityReaction(data, parentPostId, userId) {
      return data.keys().hasAll(['postId', 'uid', 'reactionType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['postId', 'uid', 'reactionType', 'createdAt', 'updatedAt'])
        && isValidId(data.postId) && data.postId == parentPostId
        && isValidId(data.uid) && data.uid == userId
        && data.reactionType in ['like', 'insightful', 'verified', 'celebrate']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityConnection(data, connectionId) {
      return data.keys().hasAll([
          'fromUid', 'toUid', 'fromName', 'toName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fromUid', 'toUid', 'fromName', 'toName', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.fromUid)
        && isValidId(data.toUid)
        && data.fromUid != data.toUid
        && connectionId == (data.fromUid + '_' + data.toUid)
        && data.fromName is string && data.fromName.size() >= 2 && data.fromName.size() <= 120
        && data.toName is string && data.toName.size() >= 2 && data.toName.size() <= 120
        && data.status in ['connected', 'pending']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityOpportunity(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'authorOrg', 'opportunityType',
          'title', 'location', 'methods', 'requirements',
          'status', 'visibility', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorUid', 'authorName', 'authorOrg', 'companyCode',
          'opportunityType', 'title', 'location', 'methods',
          'requirements', 'status', 'visibility', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120
        && data.authorOrg is string && data.authorOrg.size() >= 2 && data.authorOrg.size() <= 160
        && (!('companyCode' in data) || (data.companyCode is string && data.companyCode.size() <= 32))
        && data.opportunityType in ['job', 'tender', 'equipment']
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 180
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 140
        && data.methods is list && data.methods.size() >= 1 && data.methods.size() <= 8
        && data.methods[0] is string && data.methods[0].size() <= 32
        && data.requirements is string && data.requirements.size() >= 5 && data.requirements.size() <= 1500
        && data.status in ['open', 'closed']
        && data.visibility in ['public']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidModuleProgress(data) {
      return data.keys().hasAll(['userId', 'moduleId'])
        && data.keys().hasOnly([
          'userId', 'moduleId', 'disciplineId', 'completedTopics',
          'completedCount', 'updatedAt', 'clientTimestamp',
          'isPassed', 'score', 'unlockedCertificate', 'completedAt'
        ])
        && isValidId(data.userId)
        && data.moduleId is string && data.moduleId.matches('^[a-zA-Z0-9_-]{1,80}$')
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp)
        && (!('disciplineId' in data) || (data.disciplineId is string && data.disciplineId.size() <= 80))
        && (!('completedTopics' in data) || (data.completedTopics is list && data.completedTopics.size() <= 200))
        && (!('completedCount' in data) || (data.completedCount is number && data.completedCount >= 0 && data.completedCount <= 200))
        && (!('clientTimestamp' in data) || (data.clientTimestamp is string && data.clientTimestamp.size() <= 40))
        && (!('isPassed' in data) || data.isPassed is bool)
        && (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 100))
        && (!('unlockedCertificate' in data) || data.unlockedCertificate is bool);
    }

    function isValidQuizLeaderboardEntry(data) {
      return data.keys().hasAll(['studentName', 'disciplineId', 'percentage', 'score'])
        && data.keys().hasOnly(['studentName', 'disciplineId', 'percentage', 'score', 'badgeUnlocked', 'timestamp'])
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100
        && data.disciplineId is string && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && data.percentage is number && data.percentage >= 0 && data.percentage <= 100
        && data.score is number && data.score >= 0 && data.score <= 1000
        && (!('badgeUnlocked' in data) || data.badgeUnlocked == null || (data.badgeUnlocked is string && data.badgeUnlocked.size() <= 80));
    }

    // -------------------------------------------------------------------------
    // Admins Registry
    // -------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdminEmail());
      allow list: if isAdminEmail();
      allow create, update, delete: if isValidId(adminUid) && isAdminEmail();
    }

    // -------------------------------------------------------------------------
    // Private account reviews: administrator-managed permission, exact subject,
    // append-only reason and case ID, short server-timed authorization.
    // -------------------------------------------------------------------------
    function isAccountReviewer() {
      return isSignedIn() && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/account_reviewers/$(request.auth.uid)).data.enabled == true;
    }

    function hasAccountReview(userId) {
      let grant = get(/databases/$(database)/documents/account_review_access/$(request.auth.uid)).data;
      return grant.subjectUid == userId && grant.createdAt + duration.value(5, 'm') > request.time;
    }

    function isAccountReviewEvent(data) {
      return data.keys().hasAll(['reviewerUid', 'subjectUid', 'caseReference', 'reason', 'createdAt'])
        && data.keys().hasOnly(['reviewerUid', 'subjectUid', 'caseReference', 'reason', 'createdAt'])
        && data.reviewerUid == request.auth.uid
        && isValidId(data.subjectUid) && data.subjectUid != data.reviewerUid
        && data.caseReference is string && data.caseReference.matches('^[a-zA-Z0-9-]{4,40}$')
        && data.reason in ['account_support', 'company_link', 'data_request']
        && data.createdAt == request.time;
    }

    function isAccountReviewGrant(data) {
      let event = getAfter(/databases/$(database)/documents/account_review_audit/$(data.auditId)).data;
      return !exists(/databases/$(database)/documents/account_review_audit/$(data.auditId))
        && event.reviewerUid == request.auth.uid && event.subjectUid == data.subjectUid
        && event.createdAt == request.time && data.createdAt == request.time;
    }

    function hasCompanyLinkReview(userId) {
      let grant = get(/databases/$(database)/documents/account_review_access/$(request.auth.uid)).data;
      return grant.subjectUid == userId && grant.createdAt + duration.value(5, 'm') > request.time
        && get(/databases/$(database)/documents/account_review_audit/$(grant.auditId)).data.reason == 'company_link';
    }

    // Membership is assigned/revoked only by a trusted operator using IAM.
    match /account_reviewers/{reviewerUid} {
      allow get: if isOwner(reviewerUid) && request.auth.token.email_verified == true;
    }

    match /account_review_audit/{auditId} {
      allow create: if isValidId(auditId) && isAccountReviewer() && isAccountReviewEvent(incoming())
        && getAfter(/databases/$(database)/documents/account_review_access/$(request.auth.uid)).data.auditId == auditId;
      // No browser reads, updates, or deletes, including by reviewers.
      // Audit supervisors access the collection through separately granted IAM.
    }

    match /account_review_access/{reviewerUid} {
      allow create, update: if isOwner(reviewerUid) && isAccountReviewer()
        && incoming().keys().hasAll(['auditId', 'subjectUid', 'createdAt'])
        && incoming().keys().hasOnly(['auditId', 'subjectUid', 'createdAt'])
        && isValidId(incoming().auditId) && isValidId(incoming().subjectUid)
        && isAccountReviewGrant(incoming());
    }

    // No browser-side bulk reads of private profiles, even for administrators.
    match /client_accounts/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser()
        && (isOwner(userId) || (isAccountReviewer() && hasAccountReview(userId)));

      allow create: if isVerifiedUser() && isOwner(userId)
        && isValidId(userId)
        && isValidClientAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'client' && incoming().approvalStatus == 'pending'
          || (isAdminEmail() && incoming().role == 'admin' && incoming().approvalStatus == 'approved'))
        && (!('assignedCompanyId' in incoming()) || incoming().assignedCompanyId == '')
        && (!('assignedCompanyCode' in incoming()) || incoming().assignedCompanyCode == '');

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidClientAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'email', 'phone', 'organizationName', 'requestedCompanyCode', 'sector',
            'jobTitle', 'nationalId', 'secondaryPhone', 'personalAddress',
            'organizationNameEn', 'commercialRegNo', 'taxCardNo',
            'companyPhone', 'companyEmail', 'website', 'companyAddress',
            'cityGovernorate', 'activeScope', 'updatedAt'
          ]))
          || (isAccountReviewer() && isAdmin() && hasCompanyLinkReview(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'approvalStatus', 'assignedCompanyId', 'assignedCompanyCode', 'updatedAt'
            ]))
        );
    }

    // -------------------------------------------------------------------------
    // Opt-In Public Community Business Directory (Zero PII)
    // -------------------------------------------------------------------------
    match /community_workspaces/{userId} {
      // The member page at `#network/people/<uid>` reads this one document. A card
      // marked «للأعضاء المؤكَّدين» is refused to a signed-out reader here — that is
      // the enforcement, not a hidden button. Absence of the field means public.
      allow get: if isValidId(userId) && (
        isAdmin()
        || isOwner(userId)
        || (
          existing().isPublished == true
          && (!('profileVisibility' in existing()) || existing().profileVisibility == 'public' || isVerifiedUser())
        )
      );
      allow list: if existing().isPublished == true || isAdminEmail() || (isVerifiedUser() && existing().uid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidCommunityWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && (
          (
            isOwner(userId)
            && isValidCommunityWorkspace(incoming(), userId)
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
          )
          || (
            isValidCommunityWorkspace(incoming(), userId)
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['endorsementsCount', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // INSCO Community Feed Posts, Comments & Reactions (Zero PII)
    // -------------------------------------------------------------------------
    match /community_posts/{postId} {
      allow get: if isValidId(postId) && (
        existing().visibility == 'public'
        || isAdmin()
        || (isVerifiedUser() && existing().authorUid == request.auth.uid)
      );
      allow list: if existing().visibility == 'public'
        || isAdminEmail()
        || (isVerifiedUser() && existing().authorUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(postId)
        && isValidCommunityPost(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().aiModerationStatus == 'approved'
        && (isAdmin() || incoming().isPinnedAnnouncement == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(postId)
        && isValidCommunityPost(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().authorUid == request.auth.uid
            && incoming().isPinnedAnnouncement == existing().isPinnedAnnouncement
            && incoming().aiModerationStatus == existing().aiModerationStatus
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName', 'authorHeadline', 'authorOrg', 'authorCompanyCode',
              'postType', 'ndtMethod', 'title', 'body', 'tags',
              'technicalSnippet', 'aiSummary', 'visibility', 'updatedAt'
            ])
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1)
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && incoming().commentsCount == existing().commentsCount + 1
          )
        );

      allow delete: if isValidId(postId)
        && (isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));

      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId);
        allow list: if isValidId(postId);

        allow create: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/community_posts/$(postId))
          && isValidCommunityComment(incoming(), postId)
          && incoming().authorUid == request.auth.uid
          && incoming().createdAt == request.time;

        allow update: if false;
        allow delete: if isValidId(postId) && isValidId(commentId)
          && (isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));
      }

      match /reactions/{userId} {
        allow get: if isValidId(postId) && isValidId(userId);
        allow list: if isValidId(postId);

        allow create, update: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(userId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/community_posts/$(postId))
          && isValidCommunityReaction(incoming(), postId, userId)
          && incoming().updatedAt == request.time;

        allow delete: if isVerifiedUser()
          && isValidId(postId)
          && isValidId(userId)
          && (isOwner(userId) || isAdmin());
      }
    }

    // -------------------------------------------------------------------------
    // LinkedIn-Style Member Network Connections
    // -------------------------------------------------------------------------
    match /community_connections/{connectionId} {
      allow get: if isVerifiedUser()
        && isValidId(connectionId)
        && (isAdmin() || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow list: if isAdminEmail()
        || (isVerifiedUser() && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid));

      allow create: if isVerifiedUser()
        && isValidId(connectionId)
        && isValidCommunityConnection(incoming(), connectionId)
        && incoming().fromUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(connectionId)
        && isValidCommunityConnection(incoming(), connectionId)
        && incoming().fromUid == existing().fromUid
        && incoming().toUid == existing().toUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);

      allow delete: if isVerifiedUser()
        && isValidId(connectionId)
        && (isAdmin() || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // LinkedIn-Style NDT Jobs, Tenders & Subcontracting Board (Zero PII)
    // -------------------------------------------------------------------------
    match /community_opportunities/{opportunityId} {
      allow get: if isValidId(opportunityId)
        && (existing().visibility == 'public' || isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));
      allow list: if existing().visibility == 'public'
        || isAdminEmail()
        || (isVerifiedUser() && existing().authorUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(opportunityId)
        && isValidCommunityOpportunity(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(opportunityId)
        && isValidCommunityOpportunity(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || existing().authorUid == request.auth.uid);

      allow delete: if isValidId(opportunityId)
        && (isAdmin() || (isVerifiedUser() && existing().authorUid == request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Client Requests Intake
    // -------------------------------------------------------------------------
    match /client_requests/{requestId} {
      allow get: if isValidId(requestId)
        && (isAdmin() || (isVerifiedUser() && existing().submittedByUid == request.auth.uid));
      allow list: if isAdminEmail()
        || (isVerifiedUser() && existing().submittedByUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidClientRequest(incoming())
        && incoming().submittedByUid == request.auth.uid
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !('adminNotes' in incoming());

      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidClientRequest(incoming())
        && incoming().submittedByUid == existing().submittedByUid
        && incoming().requestCode == existing().requestCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'adminNotes', 'companyCode', 'updatedAt'
          ]))
          || (
            existing().submittedByUid == request.auth.uid
            && existing().status == 'new'
            && incoming().status == 'new'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'companyName', 'companyCode', 'contactName', 'phone',
              'serviceMethods', 'projectLocation', 'urgency', 'scopeSummary', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(requestId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Unique Company Code Reservation Index
    // -------------------------------------------------------------------------
    match /company_codes/{companyCode} {
      allow get: if isValidCode(companyCode) && (isAdmin() || (isVerifiedUser() && existing().createdByUid == request.auth.uid));
      allow list: if isAdminEmail() || (isVerifiedUser() && existing().createdByUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidCompanyCodeReservation(incoming(), companyCode)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/companies/$(incoming().companyId));
      allow update: if false;
      allow delete: if isValidCode(companyCode) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Companies Archive & Self-Service Business Workspaces
    // -------------------------------------------------------------------------
    match /companies/{companyId} {
      allow get: if isValidId(companyId)
        && (isAdmin() || (isVerifiedUser() && existing().assignedClientUid != '' && existing().assignedClientUid == request.auth.uid));
      allow list: if isAdminEmail()
        || (isVerifiedUser() && existing().assignedClientUid != '' && existing().assignedClientUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(companyId)
        && isValidCompanyRecord(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().reportsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/company_codes/$(incoming().companyCode))
        && (isAdmin() || incoming().assignedClientUid == request.auth.uid);

      allow update: if isVerifiedUser()
        && isValidId(companyId)
        && isValidCompanyRecord(incoming())
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().companyCode == existing().companyCode
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'nameAr', 'nameEn', 'archiveCategory', 'hasActiveTestingDossier',
            'sector', 'commercialRegNo', 'contactPerson', 'contactEmail',
            'contactPhone', 'projectLocation', 'activeScope',
            'assignedClientUid', 'legacySinceYear', 'reportsCount',
            'siteLat', 'siteLng', 'geofenceRadiusMeters', 'updatedAt'
          ]))
          || (
            existing().assignedClientUid == request.auth.uid
            && incoming().assignedClientUid == existing().assignedClientUid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'nameAr', 'nameEn', 'archiveCategory', 'hasActiveTestingDossier',
              'sector', 'commercialRegNo', 'contactPerson', 'contactEmail',
              'contactPhone', 'projectLocation', 'activeScope',
              'legacySinceYear', 'reportsCount',
              'siteLat', 'siteLng', 'geofenceRadiusMeters', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(companyId) && isAdmin();

      // -----------------------------------------------------------------------
      // Dedicated Company File / Dossier: Inspection Reports Subcollection
      // Master Gate: enforces parent company existence & owner/client alignment
      // -----------------------------------------------------------------------
      match /reports/{reportId} {
        allow get: if isValidId(companyId) && isValidId(reportId) && (
          isAdmin()
          || (
            isVerifiedUser()
            && get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid != ''
            && get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid == request.auth.uid
          )
        );
        allow list: if isAdminEmail()
          || (isVerifiedUser() && existing().assignedClientUid != '' && existing().assignedClientUid == request.auth.uid);

        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(reportId)
          && isValidInspectionReport(incoming(), companyId)
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && incoming().companyCode == get(/databases/$(database)/documents/companies/$(companyId)).data.companyCode
          && incoming().assignedClientUid == get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid
          && (
            isAdmin()
            || get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid == request.auth.uid
          );

        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(reportId)
          && isValidInspectionReport(incoming(), companyId)
          && incoming().companyId == existing().companyId
          && incoming().companyCode == existing().companyCode
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              existing().assignedClientUid == request.auth.uid
              && existing().status != 'archived'
              && incoming().assignedClientUid == existing().assignedClientUid
            )
          )
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'assignedClientUid', 'reportNumber', 'templateKey', 'method',
            'isLegacyArchive', 'projectName', 'clientPoNumber',
            'componentOrJointId', 'materialSpec', 'thicknessMm',
            'codeStandard', 'inspectorName', 'inspectionDate',
            'verdict', 'status', 'technicalData', 'notes', 'updatedAt'
          ]);

        allow delete: if isValidId(companyId) && isValidId(reportId)
          && (isAdmin() || (isVerifiedUser() && existing().assignedClientUid == request.auth.uid));
      }

      // -----------------------------------------------------------------------
      // Field Technicians / Employees Subcollection
      // -----------------------------------------------------------------------
      match /employees/{employeeId} {
        allow get: if isValidId(companyId) && isValidId(employeeId) && (
          isAdmin()
          || (isVerifiedUser() && (
            existing().ownerUid == request.auth.uid
            || (existing().workerUid != '' && existing().workerUid == request.auth.uid)
          ))
        );
        allow list: if isAdminEmail()
          || (isVerifiedUser() && (
            existing().ownerUid == request.auth.uid
            || (existing().workerUid != '' && existing().workerUid == request.auth.uid)
          ));

        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(employeeId)
          && isValidCompanyEmployee(incoming(), companyId)
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && incoming().companyCode == get(/databases/$(database)/documents/companies/$(companyId)).data.companyCode
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid == request.auth.uid
              && incoming().ownerUid == request.auth.uid
            )
          );

        allow update: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(employeeId)
          && isValidCompanyEmployee(incoming(), companyId)
          && incoming().companyId == existing().companyId
          && incoming().companyCode == existing().companyCode
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || existing().ownerUid == request.auth.uid
            || (
              existing().workerUid != ''
              && existing().workerUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'lastLat', 'lastLng', 'lastSeenAt', 'onlineStatus',
                'faceEnrolled', 'faceDigest', 'updatedAt'
              ])
            )
          );

        allow delete: if isValidId(companyId) && isValidId(employeeId)
          && (isAdmin() || (isVerifiedUser() && existing().ownerUid == request.auth.uid));
      }

      // -----------------------------------------------------------------------
      // Immutable Geofenced Attendance Check-In / Check-Out Timeline Logs
      // -----------------------------------------------------------------------
      match /attendance/{logId} {
        allow get: if isValidId(companyId) && isValidId(logId) && (
          isAdmin()
          || (isVerifiedUser() && (
            existing().ownerUid == request.auth.uid
            || existing().workerUid == request.auth.uid
          ))
        );
        allow list: if isAdminEmail()
          || (isVerifiedUser() && (
            existing().ownerUid == request.auth.uid
            || existing().workerUid == request.auth.uid
          ));

        allow create: if isVerifiedUser()
          && isValidId(companyId)
          && isValidId(logId)
          && isValidAttendanceLog(incoming(), companyId)
          && exists(/databases/$(database)/documents/companies/$(companyId))
          && incoming().companyCode == get(/databases/$(database)/documents/companies/$(companyId)).data.companyCode
          && incoming().workerUid == request.auth.uid
          && incoming().createdAt == request.time
          && (
            isAdmin()
            || get(/databases/$(database)/documents/companies/$(companyId)).data.assignedClientUid == request.auth.uid
            || incoming().ownerUid == request.auth.uid
          );

        allow update: if false;
        allow delete: if isValidId(companyId) && isValidId(logId) && isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // Existing Academy & Diagnostics Paths
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
    }

    match /user_module_progress/{progressId} {
      allow get: if isValidId(progressId) && isVerifiedUser()
        && (existing().userId == request.auth.uid || (isAccountReviewer() && hasAccountReview(existing().userId)));
      allow list: if isVerifiedUser() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(progressId)
        && isValidModuleProgress(incoming()) && incoming().userId == request.auth.uid
        && progressId == (incoming().userId + '_' + incoming().moduleId);
      allow update: if isVerifiedUser() && isValidId(progressId)
        && isValidModuleProgress(incoming()) && existing().userId == request.auth.uid
        && incoming().userId == existing().userId && incoming().moduleId == existing().moduleId;
      allow delete: if isVerifiedUser() && isValidId(progressId) && existing().userId == request.auth.uid;
    }

    match /quiz_leaderboard/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidQuizLeaderboardEntry(incoming());
    }
  }
}
