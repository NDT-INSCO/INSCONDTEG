# AI tutor configuration
#
# The key is read by `server.ts` only. It is never bundled into the browser:
# the static GitHub Pages build ships no key and no AI code, and the browser
# talks to `/api/ai/*` (or to `VITE_AI_BASE_URL` when the gateway lives on
# another host, e.g. Cloud Run).
GEMINI_API_KEY=
# AI_PROVIDER=auto is the default: answer from INSCO's local brain/library first,
# and use configured external AI only when local retrieval/rules cannot answer.
# Set AI_PROVIDER=local to disable all provider fallbacks explicitly.
AI_PROVIDER=auto
# The Robotic University gateway (/api/university/*) uses the same GEMINI_API_KEY.
# Overrides, all optional:
# UNIVERSITY_MODEL=            # pin the collector model (default: the agent chain)
# UNIVERSITY_RATE_PER_MINUTE=10
# UNIVERSITY_ARCHIVE_PATH=     # where the runtime archive JSON lives (default .admin-data/university-archive.json)
# UNIVERSITY_STORE=            # force the archive backend: firestore | file | memory (default: auto)
#
# Persistent FREE archive on serverless (optional — without these, the Vercel
# function keeps the runtime archive in memory and reports persisted:false):
# Firestore free Spark tier (1 GiB, 50k reads/day, 20k writes/day) is far more
# than this archive will ever hold (500 small docs max). To enable:
#   1. Firebase Console → project ai-studio-applet-webapp-18922 → Project settings
#      → Service accounts → Generate new private key (NEVER commit this file).
#   2. Set FIREBASE_SERVICE_ACCOUNT_JSON to the whole JSON on one line
#      (or point GOOGLE_APPLICATION_CREDENTIALS at the file on a Node host).
# FIREBASE_SERVICE_ACCOUNT_JSON=   # or FIREBASE_SERVICE_ACCOUNT (the name the INSCO Vercel project already uses)
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-inscointeractive-2ab74c2d-acdd-4fa3-a16b-53ea46221179
# FIREBASE_PROJECT_ID=ai-studio-applet-webapp-18922

# Where the browser should send tutor requests, when the gateway is not on the
# same origin as the page. Leave empty for same-origin (`/api/ai/*`).
# Example: https://insco-tutor-xxxx.a.run.app
VITE_AI_BASE_URL=

# Server port
PORT=3000

# Which Google interface to call.
#   auto         — Interactions API first, legacy models API only if the
#                  endpoint is unavailable (default)
#   interactions — Interactions API only (fails loudly if the key cannot use it)
#   legacy       — old models.generateContentStream path only
TUTOR_API_MODE=auto

# Optional model override for the answer. The default and its fallbacks live in
# src/ai/contract.ts (`TUTOR_MODELS`), so this only needs setting to pin a model.
TUTOR_MODEL=

# Optional server-only model override for Software Factory drafts in the admin portal.
# Uses GEMINI_API_KEY (or the existing API_KEY fallback). Local templates need no key.
FACTORY_AI_MODEL=

# Optional Manus integration for the public AI gateway, not Software Factory.
# Server only: never use a VITE_ prefix. Prefer a dedicated account with no privileged skills.
MANUS_API_KEY=
MANUS_AGENT_PROFILE=standard
MANUS_AUTO_FALLBACK=true

# Rate limits and budget (per IP, in each gateway worker)
TUTOR_RATE_PER_MINUTE=10
TUTOR_RATE_PER_DAY=200
# Daily cap across all IPs within a worker (not a project-wide serverless spend cap).
TUTOR_DAILY_LIMIT=300
TUTOR_TIMEOUT_MS=45000

# ── RFQ (طلب عرض سعر) ─────────────────────────────────────────────────────
# The browser posts the form to `VITE_RFQ_ENDPOINT` (or to same-origin
# `/api/rfq` when empty on a hosted build). A request is only reported after the
# server hands it to one of the channels below. With none configured the
# gateway answers 503 and the page offers email/WhatsApp instead.

# Browser side: gateway base (→ /api/rfq) or a full endpoint (Apps Script /exec)
VITE_RFQ_ENDPOINT=

# Server side, channel 1: approved HTTPS receiver. After saving, it must return
# {"ok":true,"reference":"<matching incoming reference>"}.
RFQ_WEBHOOK_URL=

# Server side, channel 2: transactional email via Resend.
RESEND_API_KEY=
RFQ_INBOX=
RFQ_FROM=INSCO Website <onboarding@resend.dev>

# ── Private admin workspace ─────────────────────────────────────────────
# Server only. Use a unique password of 8–128 characters, ideally generated.
# Do not use a VITE_ prefix for any secret: VITE_ variables are public.
ADMIN_PASSWORD=
# Optional legacy sign-in (8–32 digits); ignored when ADMIN_PASSWORD is set.
# Leave both empty to disable the portal.
ADMIN_PIN=
# Required in production: the canonical HTTPS host of this API. For same-origin
# passkeys it is also the staff sign-in origin. Use http://localhost:3000 for
# local passkey tests, or leave blank for local password-only development.
ADMIN_ORIGIN=
# Netlify Functions only, Production only. Enable the official Pages bearer
# API in place of Netlify's cookie sign-in. ADMIN_ORIGIN stays the Netlify origin.
ADMIN_PAGES_ENABLED=false
# Private persistent storage. Default: .admin-data/ next to server.ts.
# Use a mounted volume in production, never docs/, dist/ or public/.
ADMIN_DATA_DIR=
# Alternative to the local volume; required on Netlify and Vercel. Use a dedicated libSQL DB.
# Use a TLS URL (libsql:// or https://) and a database-scoped read/write token.
# TURSO_DATABASE_URL/TURSO_AUTH_TOKEN are supported as a pair instead.
ADMIN_DATABASE_URL=
ADMIN_DATABASE_AUTH_TOKEN=
# Hosted database only: 32 random bytes as 64 hex characters, identical on all workers.
# Keep the password, token, and this key in Production secrets, not in Git or VITE_ vars.
ADMIN_STATE_KEY=
# Optional trusted proxy IP/subnet(s), e.g. loopback for a same-host reverse proxy.
TRUST_PROXY=
# Only when the public site is on a separate host: its exact origin (no subpath).
# Enables cross-origin access to the public RFQ and announcement only.
PUBLIC_SITE_ORIGIN=
# Optional public Pages override, e.g. https://admin.example.com/. Never include a password.
# Overrides the official Pages path's local sign-in or fallback link. Use 'off' to disable.
# Leave blank for same-origin hosting or for the opt-in Pages API below.
VITE_ADMIN_PORTAL_URL=
# Public HTTPS origin of the published Netlify Pages API (no path or #admin).
# Official Pages builds only. When disabled, keep the current approved link.
# For main:/docs use INSCO_PAGES_ADMIN_API_URL in src/admin/pages.ts at cutover.
VITE_PAGES_ADMIN_API_URL=

# ── Google Maps Platform (client Vite key) ─────────────────────────────────
# Public browser API key for @vis.gl/react-google-maps (EmployeeMapTracker).
# Restrict this key by HTTP referrer and Maps JavaScript API in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

